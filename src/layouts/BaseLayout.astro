---
import '../styles/global.css';
import BackToTop from '../components/BackToTop.astro';

interface Props {
  title: string;
  description: string;
  lang: 'es' | 'ca';
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  alternateUrl?: string;
}

const {
  title,
  description,
  lang,
  canonical,
  ogImage = '/images/og-image.jpg',
  noindex = false,
  alternateUrl,
} = Astro.props;

const schema = await import('../../public/schema.json');
const altLang = lang === 'es' ? 'ca' : 'es';
const baseUrl = 'https://naturlimp.com';
const currentPath = Astro.url.pathname;
const normalizedPath = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;
const isHome = normalizedPath === '/' || normalizedPath === '/ca/';

// Smart alternate hreflang URL resolution
let resolvedAltPath = alternateUrl;
if (!resolvedAltPath) {
  if (normalizedPath === '/' || normalizedPath === '') {
    resolvedAltPath = '/ca/';
  } else if (normalizedPath === '/ca/') {
    resolvedAltPath = '/';
  } else if (lang === 'es') {
    if (normalizedPath === '/contacto/') resolvedAltPath = '/ca/contacte/';
    else if (normalizedPath === '/nosotros/') resolvedAltPath = '/ca/nosaltres/';
    else if (normalizedPath === '/servicios/') resolvedAltPath = '/ca/serveis/';
    else if (normalizedPath === '/aviso-legal/') resolvedAltPath = '/ca/avis-legal/';
    else if (normalizedPath === '/politica-de-privacidad/') resolvedAltPath = '/ca/politica-de-privacitat/';
    else if (normalizedPath === '/politica-de-cookies/') resolvedAltPath = '/ca/politica-de-cookies/';
    else if (normalizedPath.startsWith('/es/limpieza-profesional-')) {
      resolvedAltPath = normalizedPath.replace('/es/limpieza-profesional-', '/ca/neteja-professional-');
    } else if (normalizedPath.startsWith('/es/servicios/')) {
      resolvedAltPath = normalizedPath.replace('/es/servicios/', '/ca/serveis/');
    } else {
      resolvedAltPath = `/ca${normalizedPath}`;
    }
  } else {
    if (normalizedPath === '/ca/contacte/') resolvedAltPath = '/contacto/';
    else if (normalizedPath === '/ca/nosaltres/') resolvedAltPath = '/nosotros/';
    else if (normalizedPath === '/ca/serveis/') resolvedAltPath = '/servicios/';
    else if (normalizedPath === '/ca/avis-legal/') resolvedAltPath = '/aviso-legal/';
    else if (normalizedPath === '/ca/politica-de-privacitat/') resolvedAltPath = '/politica-de-privacidad/';
    else if (normalizedPath === '/ca/politica-de-cookies/') resolvedAltPath = '/politica-de-cookies/';
    else if (normalizedPath.startsWith('/ca/neteja-professional-')) {
      resolvedAltPath = normalizedPath.replace('/ca/neteja-professional-', '/es/limpieza-profesional-');
    } else if (normalizedPath.startsWith('/ca/serveis/')) {
      resolvedAltPath = normalizedPath.replace('/ca/serveis/', '/es/servicios/');
    } else {
      resolvedAltPath = normalizedPath.replace(/^\/ca/, '') || '/';
    }
  }
}

const canonicalHref = canonical ?? `${baseUrl}${normalizedPath}`;
const alternateHref = `${baseUrl}${resolvedAltPath}`;
const xDefaultHref = lang === 'es' ? canonicalHref : alternateHref;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${baseUrl}${ogImage}`;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#a2d961" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Robots & Crawler Directives -->
    {noindex ? (
      <>
        <meta name="robots" content="noindex, nofollow" />
        <meta name="googlebot" content="noindex, nofollow" />
      </>
    ) : (
      <>
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
        <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
        <meta name="bingbot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
      </>
    )}

    <!-- Favicon & App Icons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalHref} />

    <!-- hreflang i18n -->
    <link rel="alternate" hreflang={lang} href={canonicalHref} />
    <link rel="alternate" hreflang={altLang} href={alternateHref} />
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    <!-- Open Graph (WhatsApp, Facebook, LinkedIn) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NaturLimp Tarragona" />
    <meta property="og:url" content={canonical ?? `${baseUrl}${currentPath}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'ca_ES'} />
    <meta property="og:locale:alternate" content={altLang === 'es' ? 'es_ES' : 'ca_ES'} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="NaturLimp Tarragona — Limpieza profesional y multiservicios" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="NaturLimp Tarragona — Limpieza profesional y multiservicios" />

    <!-- Preloads -->
    {isHome && (
      <link rel="preload" as="image" href="/images/naturlimp-bg-hero-new.webp" type="image/webp" fetchpriority="high" />
    )}

    <!-- Fonts (Non-render-blocking with font-display: swap) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Barlow:wght@400;500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Barlow:wght@400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Barlow:wght@400;500;600;700&display=swap"
      />
    </noscript>

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(schema.default ?? schema)} />
  </head>

  <body>
    <!-- Skip link for keyboard/screen reader users -->
    <a href="#main-content" class="skip-link">
      {lang === 'es' ? 'Saltar al contenido principal' : 'Saltar al contingut principal'}
    </a>

    <slot />
    <BackToTop lang={lang} />
  </body>
</html>
