---
import Button from './Button';

interface Props {
  name: string;
  desc: string;
  icon: 'communities' | 'pools' | 'construction' | 'floors' | 'windows' | 'offices';
  href: string;
  ctaLabel: string;
  featured?: boolean;
}

const { name, desc, icon, href, ctaLabel, featured = false } = Astro.props;

const icons: Record<string, string> = {
  communities: `<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>`,
  pools: `<path d="M2 12h4l2-6 4 12 2-8 2 4h6"/><path d="M2 20h20" stroke-width="1.5"/>`,
  construction: `<rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>`,
  floors: `<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>`,
  windows: `<rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/><line x1="2" y1="10" x2="22" y2="10"/><line x1="12" y1="3" x2="12" y2="17"/>`,
  offices: `<rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>`,
};
---

{featured ? (
  <article class="group relative flex h-full flex-col overflow-hidden rounded-2xl bg-[var(--color-primary)] p-8">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.07]"
      style="background-image: radial-gradient(circle, #fff 1px, transparent 1px); background-size: 28px 28px;"
      aria-hidden="true"
    />

    <div class="relative z-10 flex h-full flex-col">
      <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-white/20 backdrop-blur-sm">
        <svg
          width="28" height="28" viewBox="0 0 24 24"
          fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          aria-hidden="true" set:html={icons[icon]}
        />
      </div>

      <h3 class="font-heading text-xl font-bold text-white mb-3">{name}</h3>
      <p class="text-sm text-white/75 leading-relaxed flex-1">{desc}</p>

      <Button
        client:load
        as="a"
        href={href}
        variant="white"
        size="sm"
        className="mt-8 hover:gap-3 !rounded-full"
        rightIcon={
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        }
      >
        {ctaLabel}
      </Button>
    </div>
  </article>
) : (
  <article class="group flex h-full flex-col rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 transition-all duration-200 hover:border-[var(--color-primary)]/30 hover:shadow-md">
    <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-[var(--color-primary-light)]">
      <svg
        width="22" height="22" viewBox="0 0 24 24"
        fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        aria-hidden="true" set:html={icons[icon]}
      />
    </div>

    <h3 class="font-heading text-base font-semibold text-[var(--color-foreground)] mb-2">{name}</h3>
    <p class="text-sm text-[var(--color-muted-fg)] leading-relaxed flex-1">{desc}</p>

    <Button
      client:load
      as="a"
      href={href}
      variant="link"
      className="mt-5 hover:gap-2 !text-[var(--color-primary)]"
      rightIcon={
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      }
    >
      {ctaLabel}
    </Button>
  </article>
)}
