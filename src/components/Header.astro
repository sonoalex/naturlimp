---
import Button from './Button';

interface Props {
  lang: 'es' | 'ca';
  t: Record<string, string>;
}

const { lang, t } = Astro.props;
const isCa = lang === 'ca';
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = currentPath === '/' || currentPath === '/ca';

const serviceSlugMapEsToCa: Record<string, string> = {
  'limpieza-comunidades-tarragona': 'neteja-comunitats-tarragona',
  'jardineria-tarragona': 'jardineria-tarragona',
  'piscinas-comunitarias-tarragona': 'neteja-piscines-tarragona',
  'limpieza-parkings-tarragona': 'neteja-parquings-tarragona',
  'abrillantado-suelos-tarragona': 'abrillantat-terres-tarragona',
  'pintura-reformas-tarragona': 'pintura-reformes-tarragona',
  'electricidad-tarragona': 'electricitat-tarragona',
  'limpieza-final-obra-tarragona': 'neteja-final-obra-tarragona',
  'limpieza-oficinas-tarragona': 'neteja-oficines-tarragona',
  'apartamentos-turisticos-tarragona': 'apartaments-turistics-tarragona',
  'limpieza-centros-salud-colegios-tarragona': 'neteja-centres-salut-colegis-tarragona',
  'limpieza-cristales-tarragona': 'neteja-vidres-tarragona',
};
const serviceSlugMapCaToEs: Record<string, string> = Object.fromEntries(
  Object.entries(serviceSlugMapEsToCa).map(([es, ca]) => [ca, es])
);

const altLang = isCa ? 'es' : 'ca';
let altPath = '/';
if (isCa) {
  if (currentPath === '/ca/serveis') altPath = '/servicios/';
  else if (currentPath === '/ca/contacte') altPath = '/contacto/';
  else if (currentPath === '/ca/nosaltres') altPath = '/nosotros/';
  else if (currentPath === '/ca') altPath = '/';
  else if (currentPath.startsWith('/ca/serveis/')) {
    const slug = currentPath.replace('/ca/serveis/', '');
    const mapped = serviceSlugMapCaToEs[slug] || slug;
    altPath = `/es/servicios/${mapped}/`;
  }
  else altPath = `${currentPath.replace(/^\/ca/, '/es')}/`;
} else {
  if (currentPath === '/servicios') altPath = '/ca/serveis/';
  else if (currentPath === '/contacto') altPath = '/ca/contacte/';
  else if (currentPath === '/nosotros') altPath = '/ca/nosaltres/';
  else if (currentPath === '/') altPath = '/ca/';
  else if (currentPath.startsWith('/es/servicios/')) {
    const slug = currentPath.replace('/es/servicios/', '');
    const mapped = serviceSlugMapEsToCa[slug] || slug;
    altPath = `/ca/serveis/${mapped}/`;
  }
  else altPath = `/ca${currentPath.replace(/^\/es/, '')}/`;
}

const servicesHref     = isCa ? '/ca/serveis/' : '/servicios/';
const aboutHref        = isCa ? '/ca/nosaltres/' : '/nosotros/';
const testimonialsHref = isCa ? '/ca/#opinions' : '/#testimonios';
const contactHref      = isCa ? '/ca/contacte/' : '/contacto/';
const faqHref          = isCa ? '/ca/#faq' : '/#faq';

const isServicesActive = currentPath === '/servicios' || currentPath === '/ca/serveis' || currentPath.startsWith('/servicios') || currentPath.startsWith('/ca/serveis') || currentPath.startsWith('/es/servicios');
const isAboutActive = currentPath === '/nosotros' || currentPath === '/ca/nosaltres';
const isContactActive = currentPath === '/contacto' || currentPath === '/ca/contacte';

const serviceLinks = isCa ? [
  { label: 'Neteja de comunitats',                                  href: '/ca/serveis/neteja-comunitats-tarragona/' },
  { label: 'Jardineria',                                            href: '/ca/serveis/jardineria-tarragona/' },
  { label: 'Manteniment piscines',                                  href: '/ca/serveis/neteja-piscines-tarragona/' },
  { label: 'Neteja de pàrquings',                                   href: '/ca/serveis/neteja-parquings-tarragona/' },
  { label: 'Polits i abrillantats',                                 href: '/ca/serveis/abrillantat-terres-tarragona/' },
  { label: 'Pintura i reformes',                                    href: '/ca/serveis/pintura-reformes-tarragona/' },
  { label: 'Electricitat',                                          href: '/ca/serveis/electricitat-tarragona/' },
  { label: "Neteja final d'obra",                                   href: '/ca/serveis/neteja-final-obra-tarragona/' },
  { label: "Neteja d'oficines i locals",                            href: '/ca/serveis/neteja-oficines-tarragona/' },
  { label: 'Apartaments turístics',                                 href: '/ca/serveis/apartaments-turistics-tarragona/' },
  { label: 'Residències, farmàcies, col·legis i centres de salut',   href: '/ca/serveis/neteja-centres-salut-colegis-tarragona/' },
] : [
  { label: 'Limpieza comunidades',                                  href: '/es/servicios/limpieza-comunidades-tarragona/' },
  { label: 'Jardinería',                                            href: '/es/servicios/jardineria-tarragona/' },
  { label: 'Mantenimiento piscinas',                                href: '/es/servicios/piscinas-comunitarias-tarragona/' },
  { label: 'Limpieza de parkings',                                  href: '/es/servicios/limpieza-parkings-tarragona/' },
  { label: 'Pulidos y abrillantados',                               href: '/es/servicios/abrillantado-suelos-tarragona/' },
  { label: 'Pintura y reformas',                                    href: '/es/servicios/pintura-reformas-tarragona/' },
  { label: 'Electricidad',                                          href: '/es/servicios/electricidad-tarragona/' },
  { label: 'Limpieza final de obra',                                href: '/es/servicios/limpieza-final-obra-tarragona/' },
  { label: 'Limpieza de oficinas y locales',                        href: '/es/servicios/limpieza-oficinas-tarragona/' },
  { label: 'Apartamentos turísticos',                               href: '/es/servicios/apartamentos-turisticos-tarragona/' },
  { label: 'Residencias, farmacias, colegios y centros de la salud', href: '/es/servicios/limpieza-centros-salud-colegios-tarragona/' },
];

const navLinks = [
  { label: t['nav.services'],               href: servicesHref,     section: isCa ? 'serveis'   : 'servicios' },
  { label: isCa ? 'Nosaltres' : 'Nosotros', href: aboutHref,        section: isCa ? 'nosaltres' : 'nosotros' },
  { label: t['nav.testimonials'],           href: testimonialsHref, section: isCa ? 'opinions'  : 'testimonios' },
  { label: 'FAQ',                           href: faqHref,          section: 'faq' },
];
---

<!-- ── Mobile top bar ────────────────────────────────────────────────────── -->
<div
  id="mobile-top-bar"
  class="fixed top-0 inset-x-0 z-50 md:hidden flex items-center justify-between px-4 h-14
         bg-[var(--color-surface)]/95 backdrop-blur-md border-b border-[var(--color-border)] shadow-sm"
  style="transform: translateY(-100%); transition: transform 0.3s ease-out;"
>
  <a
    href={isCa ? '/ca' : '/'}
    class="flex items-center gap-2"
    aria-label="NaturLimp — Inici"
  >
    <img src="/images/logo-symbol.png" alt="NaturLimp" class="h-6 w-auto object-contain" width="24" height="24" />
    <span class="font-display text-sm font-bold tracking-tight text-[var(--color-foreground)]">NaturLimp</span>
  </a>

  <div class="flex items-center gap-2">
    <Button
      client:load
      as="a"
      href={contactHref}
      variant="primary"
      size="sm"
      className="h-8 px-3.5 !rounded-full text-xs font-bold"
    >
      {isCa ? 'Pressupost' : 'Presupuesto'}
    </Button>
    <button
      id="mobile-menu-toggle"
      type="button"
      class="flex items-center justify-center h-8 w-8 rounded-full border border-[var(--color-border)] bg-[var(--color-muted)] text-[var(--color-foreground)] hover:bg-[var(--color-muted)]/80 transition-colors focus:outline-none"
      aria-label={isCa ? "Obrir menú" : "Abrir menú"}
      aria-expanded="false"
    >
      <svg id="hamburger-icon" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="close-icon" class="w-4 h-4 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</div>

<!-- ── Mobile Drawer Menu ────────────────────────────────────────────────── -->
<div
  id="mobile-drawer"
  class="fixed inset-0 z-50 md:hidden pointer-events-none opacity-0 transition-opacity duration-300"
  aria-hidden="true"
>
  <!-- Backdrop -->
  <div id="mobile-drawer-backdrop" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>

  <!-- Drawer content -->
  <div
    id="mobile-drawer-panel"
    class="absolute top-0 right-0 bottom-0 w-[85%] max-w-[340px] bg-[var(--color-surface)] shadow-2xl flex flex-col justify-between p-6 transform translate-x-full transition-transform duration-300 ease-out overflow-y-auto"
  >
    <div>
      <!-- Drawer header -->
      <div class="flex items-center justify-between pb-4 border-b border-[var(--color-border)]">
        <div class="flex items-center gap-2">
          <img src="/images/logo-symbol.png" alt="NaturLimp" class="h-6 w-auto object-contain" width="24" height="24" />
          <span class="font-display text-base font-bold tracking-tight text-[var(--color-foreground)]">NaturLimp</span>
        </div>
        <button
          id="mobile-drawer-close"
          type="button"
          class="p-1.5 rounded-full hover:bg-[var(--color-muted)] text-[var(--color-muted-fg)] hover:text-[var(--color-foreground)] transition-colors"
          aria-label={isCa ? "Tancar menú" : "Cerrar menú"}
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Links list -->
      <nav class="flex flex-col gap-1 py-4">
        <a
          href={isCa ? '/ca' : '/'}
          class="flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-semibold text-[var(--color-foreground)] hover:bg-[var(--color-muted)] transition-colors"
        >
          <svg class="w-4 h-4 text-[var(--color-primary)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
          </svg>
          {isCa ? 'Inici' : 'Inicio'}
        </a>

        <!-- Servicios -->
        <div>
          <a
            href={servicesHref}
            class={`flex items-center justify-between px-3 py-2 rounded-xl text-sm font-semibold transition-colors ${isServicesActive ? 'bg-[var(--color-primary)]/10 text-[var(--color-primary-dark)] font-bold' : 'text-[var(--color-foreground)] hover:bg-[var(--color-muted)]'}`}
          >
            <div class="flex items-center gap-3">
              <svg class="w-4 h-4 text-[var(--color-primary)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
                <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
              </svg>
              <span>{t['nav.services']}</span>
            </div>
            <span class="text-[11px] px-2 py-0.5 rounded-full bg-[var(--color-primary)]/20 text-[var(--color-foreground)] font-bold">{serviceLinks.length}</span>
          </a>

          <!-- Subservices indented -->
          <div class="pl-7 pr-2 py-1 flex flex-col gap-0.5 border-l-2 border-[var(--color-border)] ml-5 my-1">
            {serviceLinks.map(s => (
              <a
                href={s.href}
                class="text-xs text-[var(--color-muted-fg)] hover:text-[var(--color-primary-dark)] py-1 transition-colors"
              >
                {s.label}
              </a>
            ))}
          </div>
        </div>

        <!-- Nosotros -->
        <a
          href={aboutHref}
          class={`flex items-center justify-between px-3 py-2 rounded-xl text-sm font-semibold transition-colors ${isAboutActive ? 'bg-[var(--color-primary)]/10 text-[var(--color-primary-dark)] font-bold' : 'text-[var(--color-foreground)] hover:bg-[var(--color-muted)]'}`}
        >
          <div class="flex items-center gap-3">
            <svg class="w-4 h-4 text-[var(--color-primary)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            <span>{isCa ? 'Nosaltres' : 'Nosotros'}</span>
          </div>
          <span class="text-[10px] font-bold text-[var(--color-primary-dark)] bg-[var(--color-primary)]/20 px-2 py-0.5 rounded-full">+17 {isCa ? 'anys' : 'años'}</span>
        </a>

        <!-- Opiniones -->
        <a
          href={testimonialsHref}
          class="flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-semibold text-[var(--color-foreground)] hover:bg-[var(--color-muted)] transition-colors"
        >
          <svg class="w-4 h-4 text-[var(--color-primary)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </svg>
          {isCa ? 'Opinions' : 'Opiniones'}
        </a>

        <!-- FAQ -->
        <a
          href={faqHref}
          class="flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-semibold text-[var(--color-foreground)] hover:bg-[var(--color-muted)] transition-colors"
        >
          <svg class="w-4 h-4 text-[var(--color-primary)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10"/>
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
            <line x1="12" y1="17" x2="12.01" y2="17"/>
          </svg>
          FAQ
        </a>

        <!-- Contacto -->
        <a
          href={contactHref}
          class={`flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-semibold transition-colors ${isContactActive ? 'bg-[var(--color-primary)]/10 text-[var(--color-primary-dark)] font-bold' : 'text-[var(--color-foreground)] hover:bg-[var(--color-muted)]'}`}
        >
          <svg class="w-4 h-4 text-[var(--color-primary)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
          {isCa ? 'Contacte' : 'Contacto'}
        </a>
      </nav>
    </div>

    <!-- Drawer Footer Actions -->
    <div class="pt-4 border-t border-[var(--color-border)] flex flex-col gap-3">
      <!-- Idioma -->
      <a
        href={altPath}
        class="flex items-center justify-between px-3 py-2 rounded-xl text-xs font-bold uppercase tracking-wider text-[var(--color-muted-fg)] bg-[var(--color-muted)]/50 hover:bg-[var(--color-muted)] hover:text-[var(--color-foreground)] transition-colors"
      >
        <span class="flex items-center gap-2">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
          {isCa ? 'Idioma: Català' : 'Idioma: Castellano'}
        </span>
        <span class="text-[var(--color-primary-dark)] font-bold">{isCa ? 'Canviar a ES' : 'Cambiar a CA'}</span>
      </a>

      <!-- Quick call / WhatsApp -->
      <div class="grid grid-cols-2 gap-2">
        <a
          href="tel:+34603765253"
          class="flex items-center justify-center gap-1.5 py-2 px-2.5 rounded-xl border border-[var(--color-border)] text-xs font-bold text-[var(--color-foreground)] hover:bg-[var(--color-muted)] transition-colors text-center"
        >
          <svg class="w-3.5 h-3.5 text-[var(--color-primary)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          Llamar
        </a>
        <a
          href="https://wa.me/34603765253"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-1.5 py-2 px-2.5 rounded-xl bg-[#25D366]/15 text-[#128C7E] text-xs font-bold hover:bg-[#25D366]/25 transition-colors text-center"
        >
          WhatsApp
        </a>
      </div>

      <!-- Presupuesto CTA -->
      <Button
        client:load
        as="a"
        href={contactHref}
        variant="primary"
        size="md"
        className="w-full !rounded-xl font-bold justify-center"
      >
        {isCa ? 'Demanar Pressupost' : 'Pedir Presupuesto'}
      </Button>
    </div>
  </div>
</div>

<script>
  const bar = document.getElementById('mobile-top-bar') as HTMLElement | null;
  const isHomePage = window.location.pathname === '/' || window.location.pathname === '/ca' || window.location.pathname === '/ca/';

  if (bar) {
    if (!isHomePage) {
      bar.style.transform = 'translateY(0)';
    } else {
      let rafId = 0;
      window.addEventListener('scroll', () => {
        if (rafId) cancelAnimationFrame(rafId);
        rafId = requestAnimationFrame(() => {
          bar.style.transform = window.scrollY > 40 ? 'translateY(0)' : 'translateY(-100%)';
        });
      }, { passive: true });
    }
  }

  // Drawer open/close logic
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-drawer');
  const backdrop = document.getElementById('mobile-drawer-backdrop');
  const panel = document.getElementById('mobile-drawer-panel');
  const closeBtn = document.getElementById('mobile-drawer-close');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  function openDrawer() {
    if (!drawer || !panel) return;
    drawer.classList.remove('pointer-events-none', 'opacity-0');
    drawer.classList.add('pointer-events-auto', 'opacity-100');
    panel.classList.remove('translate-x-full');
    panel.classList.add('translate-x-0');
    hamburgerIcon?.classList.add('hidden');
    closeIcon?.classList.remove('hidden');
    toggleBtn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    if (!drawer || !panel) return;
    drawer.classList.add('pointer-events-none', 'opacity-0');
    drawer.classList.remove('pointer-events-auto', 'opacity-100');
    panel.classList.add('translate-x-full');
    panel.classList.remove('translate-x-0');
    hamburgerIcon?.classList.remove('hidden');
    closeIcon?.classList.add('hidden');
    toggleBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  toggleBtn?.addEventListener('click', () => {
    const isOpen = toggleBtn.getAttribute('aria-expanded') === 'true';
    if (isOpen) closeDrawer();
    else openDrawer();
  });
  closeBtn?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);
  drawer?.querySelectorAll('a').forEach(a => a.addEventListener('click', closeDrawer));
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeDrawer();
  });
</script>

<!-- ── Desktop pill navbar ─────────────────────────────────────────────────── -->
<header
  id="pill-nav"
  class="fixed top-5 left-1/2 z-50 hidden -translate-x-1/2 md:flex items-center gap-1 px-3 py-2 rounded-full
         bg-[var(--color-surface)]/92 backdrop-blur-lg
         border border-[var(--color-border)]
         shadow-[0_2px_24px_rgba(0,0,0,0.07)]
         transition-shadow duration-300"
>

  <!-- Logo -->
  <a
    href={isCa ? '/ca' : '/'}
    class="flex items-center gap-2 px-2 py-1 rounded-full hover:bg-[var(--color-muted)] transition-colors duration-150"
    aria-label="NaturLimp — Inicio"
  >
    <img src="/images/logo-symbol.png" alt="NaturLimp" class="h-6 w-auto object-contain" width="24" height="24" />
    <span class="font-display text-sm font-bold tracking-tight text-[var(--color-foreground)]">NaturLimp</span>
  </a>

  <!-- Separator -->
  <div class="h-4 w-px bg-[var(--color-border)] mx-1" aria-hidden="true" />

  <!-- Nav links with text-scroll hover -->
  <nav class="flex items-center" aria-label={isCa ? 'Navegació principal' : 'Navegación principal'}>
    {navLinks.map(({ label, href, section }) => {
      const isActive = currentPath === href;
      return (
        <a
          href={href}
          data-nav-section={section}
          data-active={isActive ? 'true' : undefined}
          class="nav-pill-link group relative flex items-center px-3 py-1.5 rounded-full text-sm hover:bg-[var(--color-muted)] transition-colors duration-150 cursor-pointer"
        >
          <span style="display:block; height:1.25rem; overflow:hidden;">
            <span class={`flex flex-col transition-transform duration-300 ease-out ${isActive ? '' : 'group-hover:-translate-y-1/2 group-focus-visible:-translate-y-1/2'}`}>
              <span class={`leading-5 ${isActive ? 'font-semibold text-[var(--color-foreground)]' : 'text-[var(--color-muted-fg)]'}`}>{label}</span>
              <span class="leading-5 font-medium text-[var(--color-foreground)]">{label}</span>
            </span>
          </span>
        </a>
      );
    })}
  </nav>

  <!-- Separator -->
  <div class="h-4 w-px bg-[var(--color-border)] mx-1" aria-hidden="true" />

  <!-- Language switcher -->
  <a
    href={altPath}
