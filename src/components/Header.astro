<!-- ── Active section tracking ────────────────────────────────────────────── -->
<script>
  function initNavActive() {
    const allSectionIds = [
      'servicios', 'serveis',
      'nosotros', 'nosaltres',
      'testimonios', 'opinions',
      'faq',
      'contacto', 'contacte',
    ];

    const sections = allSectionIds
      .map(id => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    // Only mobile links — desktop pill links also carry data-nav-section
    const mobileLinks = document.querySelectorAll<HTMLElement>('.mobile-nav-link[data-nav-section]');

    function setActive(sectionId: string | null) {
      mobileLinks.forEach(link => {
        const isActive = link.dataset.navSection === sectionId;
        link.style.color = isActive ? 'var(--color-primary)' : '';
        const dot = link.querySelector<HTMLElement>('.mobile-nav-dot');
        if (dot) dot.style.transform = isActive ? 'translateX(-50%) scaleX(1)' : 'translateX(-50%) scaleX(0)';
      });
    }

    function getActiveSection(): string | null {
      const threshold = window.innerHeight * 0.45;
      let activeId: string | null = null;
      for (const section of sections) {
        if (section.getBoundingClientRect().top <= threshold) {
          activeId = section.id;
        }
      }
      return activeId;
    }

    let rafId = 0;
    window.addEventListener('scroll', () => {
      if (rafId) cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(() => setActive(getActiveSection()));
    }, { passive: true });

    setActive(getActiveSection());
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNavActive);
  } else {
    initNavActive();
  }
</script>

<style>
