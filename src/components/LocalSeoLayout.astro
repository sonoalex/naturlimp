---
import ContactForm from './ContactForm';

interface Props {
  city: string;        // "Reus"
  citySlug: string;    // "reus"
  distanceKm: number;  // 12
  province: string;    // "Tarragona"
  t: any;
  lang: 'es' | 'ca';
}

const { city, citySlug, distanceKm, province, t, lang } = Astro.props;

const isEs = lang === 'es';
const contactId = isEs ? 'contacto' : 'contacte';
const canonicalUrl = isEs
  ? `https://naturlimp.com/es/limpieza-profesional-${citySlug}`
  : `https://naturlimp.com/ca/neteja-professional-${citySlug}`;

const serviceLinks = isEs ? [
  { label: 'Limpieza de comunidades',  href: '/es/servicios/limpieza-comunidades-tarragona' },
  { label: 'Piscinas comunitarias',    href: '/es/servicios/piscinas-comunitarias-tarragona' },
  { label: 'Limpieza final de obra',   href: '/es/servicios/limpieza-final-obra-tarragona' },
  { label: 'Abrillantado de suelos',   href: '/es/servicios/abrillantado-suelos-tarragona' },
  { label: 'Limpieza de cristales',    href: '/es/servicios/limpieza-cristales-tarragona' },
  { label: 'Limpieza de oficinas',     href: '/es/servicios/limpieza-oficinas-tarragona' },
] : [
  { label: 'Neteja de comunitats',     href: '/ca/serveis/neteja-comunitats-tarragona' },
  { label: 'Piscines comunitàries',    href: '/ca/serveis/neteja-piscines-tarragona' },
  { label: "Neteja final d'obra",      href: '/ca/serveis/neteja-final-obra-tarragona' },
  { label: 'Abrillantat de terres',    href: '/ca/serveis/abrillantat-terres-tarragona' },
  { label: 'Neteja de vidres',         href: '/ca/serveis/neteja-vidres-tarragona' },
  { label: "Neteja d'oficines",        href: '/ca/serveis/neteja-oficines-tarragona' },
];

const proximityText = isEs
  ? (distanceKm <= 10
      ? `a solo ${distanceKm} km de nuestra base en Tarragona`
      : distanceKm <= 20
      ? `a ${distanceKm} km de Tarragona, dentro de nuestra zona de servicio habitual`
      : `a ${distanceKm} km de Tarragona, cubierta dentro de nuestro radio de 30 km`)
  : (distanceKm <= 10
      ? `a tan sols ${distanceKm} km de la nostra base a Tarragona`
      : distanceKm <= 20
      ? `a ${distanceKm} km de Tarragona, dins la nostra zona de servei habitual`
      : `a ${distanceKm} km de Tarragona, coberta dins el nostre radi de 30 km`);

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": isEs
    ? `NaturLimp - Limpieza profesional en ${city}`
    : `NaturLimp - Neteja professional a ${city}`,
  "description": isEs
    ? `Empresa de limpieza profesional en ${city}, ${province}. Comunidades de vecinos, piscinas comunitarias, final de obra, abrillantado de suelos, cristales y oficinas.`
    : `Empresa de neteja professional a ${city}, ${province}. Comunitats de veïns, piscines comunitàries, final d'obra, abrillantat de terres, vidres i oficines.`,
  "url": canonicalUrl,
  "telephone": "+34977000000",
  "email": "info@naturlimp.com",
  "priceRange": "€€",
  "image": "https://naturlimp.com/og-image.jpg",
  "logo": "https://naturlimp.com/logo.png",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": city,
    "addressRegion": province,
    "addressCountry": "ES"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "41.1189",
    "longitude": "1.2445"
  },
  "areaServed": { "@type": "City", "name": city },
  "openingHoursSpecification": [
    { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "08:00", "closes": "18:00" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "09:00", "closes": "14:00" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": isEs ? `Servicios de limpieza en ${city}` : `Serveis de neteja a ${city}`,
    "itemListElement": isEs ? [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Limpieza de comunidades de vecinos" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Limpieza de piscinas comunitarias" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Limpieza final de obra" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Abrillantado de suelos" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Limpieza de cristales" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Limpieza de oficinas y locales" } }
    ] : [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Neteja de comunitats de veïns" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Neteja de piscines comunitàries" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Neteja final d'obra" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Abrillantat de terres" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Neteja de vidres" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Neteja d'oficines i locals" } }
    ]
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": isEs ? "Inicio" : "Inici", "item": isEs ? "https://naturlimp.com/" : "https://naturlimp.com/ca" },
    { "@type": "ListItem", "position": 2, "name": isEs ? `Limpieza en ${city}` : `Neteja a ${city}`, "item": canonicalUrl }
  ]
};

const faqItems = isEs ? [
  {
    q: `¿Hacéis limpieza de comunidades en ${city}?`,
    a: `Sí. NaturLimp presta servicio de limpieza de comunidades de vecinos en ${city} con equipo propio y seguro de responsabilidad civil incluido. Cubrimos portales, escaleras, garajes y zonas comunes.`
  },
  {
    q: `¿Cuánto cuesta la limpieza profesional en ${city}?`,
    a: `El precio depende del tipo de servicio y superficie. Para comunidades estándar en ${city} el servicio semanal parte desde 120 €/mes. Contacta para un presupuesto gratuito sin compromiso.`
  },
  {
    q: `¿Cuánto tardáis en llegar a ${city} desde Tarragona?`,
    a: `${city} está ${proximityText}. Nuestros equipos llegan en un tiempo reducido y cubrimos la zona de forma regular.`
  },
  {
    q: `¿Ofrecéis limpieza final de obra en ${city}?`,
    a: `Sí, realizamos limpiezas de final de obra en ${city} y toda la comarca. Retiramos polvo de obra, restos de cemento, pinturas y dejamos el espacio listo para entregar o habitar.`
  }
] : [
  {
    q: `Feu neteja de comunitats a ${city}?`,
    a: `Sí. NaturLimp presta servei de neteja de comunitats de veïns a ${city} amb equip propi i assegurança de responsabilitat civil inclosa. Cobrim portals, escales, garatges i zones comunes.`
  },
  {
    q: `Quant costa la neteja professional a ${city}?`,
    a: `El preu depèn del tipus de servei i superfície. Per a comunitats estàndard a ${city} el servei setmanal comença des de 120 €/mes. Contacta per a un pressupost gratuït sense compromís.`
  },
  {
    q: `Quant tardeu a arribar a ${city} des de Tarragona?`,
    a: `${city} es troba ${proximityText}. Els nostres equips arriben en poc temps i cobrim la zona de forma regular.`
  },
  {
    q: `Oferiu neteja final d'obra a ${city}?`,
    a: `Sí, realitzem neteges de final d'obra a ${city} i tota la comarca. Retirem pols d'obra, restes de ciment, pintures i deixem l'espai llest per entregar o habitar.`
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(({ q, a }) => ({
    "@type": "Question",
    "name": q,
    "acceptedAnswer": { "@type": "Answer", "text": a }
  }))
};

const whatsappMsg = isEs
  ? 'Hola%2C%20me%20gustar%C3%ADa%20pedir%20un%20presupuesto'
  : 'Hola%2C%20m%27agradaria%20demanar%20un%20pressupost';
---

<article>

  <!-- Structured data -->
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- ── HERO ──────────────────────────────────────────────────────────────── -->
  <section class="relative overflow-hidden bg-[var(--color-foreground)] text-white">
    <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[var(--color-primary)] to-transparent" aria-hidden="true"></div>
    <div
      class="absolute inset-0 pointer-events-none"
      style="background-image:linear-gradient(rgba(255,255,255,0.018) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.018) 1px,transparent 1px);background-size:52px 52px;"
      aria-hidden="true"
    ></div>
    <div class="absolute right-0 top-1/2 -translate-y-1/2 pointer-events-none select-none overflow-hidden" aria-hidden="true">
      <span class="block font-display font-bold leading-none text-white" style="font-size:clamp(120px,18vw,300px);opacity:0.04;">{city.toUpperCase().slice(0,4)}</span>
    </div>

    <div class="relative z-10 mx-auto max-w-6xl px-6 py-24 sm:px-10 lg:px-14">
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 text-xs uppercase tracking-widest text-white/30">
          <li><a href={isEs ? '/' : '/ca'} class="hover:text-white/60 transition-colors">{isEs ? 'Inicio' : 'Inici'}</a></li>
          <li aria-hidden="true" class="text-white/20">›</li>
          <li aria-current="page" class="text-white/50">{isEs ? `Limpieza en ${city}` : `Neteja a ${city}`}</li>
        </ol>
      </nav>

      <div class="mb-6">
        <span class="inline-flex items-center gap-2 rounded-sm border border-[var(--color-primary)]/40 bg-[var(--color-primary)]/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--color-primary-light)]">
          <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-primary)]" aria-hidden="true"></span>
          {isEs ? `Limpieza profesional · ${city} · ${province}` : `Neteja professional · ${city} · ${province}`}
        </span>
      </div>

      <h1 class="font-display font-bold tracking-tight" style="font-size:clamp(2rem,6vw,4.5rem);line-height:1.05;max-width:22ch;">
        {isEs ? `Limpieza profesional en ${city}` : `Neteja professional a ${city}`}
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/50">
        {isEs
          ? `Empresa local de limpieza ${proximityText}. Comunidades de vecinos, piscinas, final de obra, cristales y oficinas. Equipo propio, seguro RC incluido y presupuesto sin compromiso.`
          : `Empresa local de neteja ${proximityText}. Comunitats de veïns, piscines, final d'obra, vidres i oficines. Equip propi, assegurança RC inclosa i pressupost sense compromís.`}
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a
          href={`#${contactId}`}
          class="inline-flex items-center justify-center rounded-lg bg-[var(--color-accent)] px-8 py-4 text-base font-semibold text-white transition-all duration-200 hover:bg-[var(--color-primary)] hover:scale-[1.02] active:scale-[0.99]"
        >
          {isEs ? 'Solicitar presupuesto gratis' : 'Sol·licitar pressupost gratis'}
        </a>
        <a
          href="tel:+34977000000"
          class="inline-flex items-center gap-2 rounded-lg border border-white/15 px-6 py-4 text-sm font-medium text-white/70 transition-all duration-200 hover:border-white/30 hover:text-white"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.99 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.9 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          977 000 000
        </a>
      </div>

      <div class="mt-12 flex flex-wrap gap-x-8 gap-y-3">
        <div class="flex items-baseline gap-2">
          <span class="font-display text-2xl font-bold text-[var(--color-primary-light)]">15</span>
          <span class="text-sm text-white/30">{isEs ? 'años de experiencia' : 'anys d\'experiència'}</span>
        </div>
        <div class="flex items-baseline gap-2">
          <span class="font-display text-2xl font-bold text-[var(--color-primary-light)]">{distanceKm} km</span>
          <span class="text-sm text-white/30">{isEs ? 'desde Tarragona' : 'des de Tarragona'}</span>
        </div>
        <div class="flex items-baseline gap-2">
          <span class="font-display text-2xl font-bold text-[var(--color-primary-light)]">24 h</span>
          <span class="text-sm text-white/30">{isEs ? 'tiempo de respuesta' : 'temps de resposta'}</span>
        </div>
        <div class="flex items-baseline gap-2">
          <span class="font-display text-2xl font-bold text-[var(--color-primary-light)]">RC</span>
          <span class="text-sm text-white/30">{isEs ? 'seguro incluido' : 'assegurança inclosa'}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SERVEIS / SERVICIOS ───────────────────────────────────────────────── -->
  <section class="py-20 bg-[var(--color-background)]" aria-labelledby="servicios-heading">
    <div class="mx-auto max-w-6xl px-6 sm:px-10 lg:px-14">
      <div class="reveal mb-12">
        <p class="mb-2 text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-primary)]">{isEs ? 'Cobertura completa' : 'Cobertura completa'}</p>
        <h2 id="servicios-heading" class="font-display text-3xl font-bold text-[var(--color-foreground)] sm:text-4xl">
          {isEs ? `Servicios de limpieza en ${city}` : `Serveis de neteja a ${city}`}
        </h2>
        <p class="mt-4 max-w-2xl text-[var(--color-muted-fg)] leading-relaxed">
          {isEs
            ? `Todos nuestros servicios profesionales disponibles en ${city} y municipios cercanos. Mismo equipo, misma calidad que en Tarragona.`
            : `Tots els nostres serveis professionals disponibles a ${city} i municipis propers. Mateix equip, mateixa qualitat que a Tarragona.`}
        </p>
      </div>

      <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {serviceLinks.map(({ label, href }, i) => (
          <li class="reveal" style={`transition-delay:${i * 40}ms`}>
            <a
              href={href}
              class="group flex items-start gap-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5 transition-all duration-200 hover:border-[var(--color-primary)]/40 hover:shadow-sm hover:-translate-y-0.5"
            >
              <span class="mt-0.5 flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-[var(--color-primary)]/10 text-[var(--color-primary)] transition-colors group-hover:bg-[var(--color-primary)]/20" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                  <path d="m9 12 2 2 4-4"/>
                </svg>
              </span>
              <span class="text-sm font-medium text-[var(--color-foreground)] group-hover:text-[var(--color-primary)]">{label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── PROXIMITAT / PROXIMIDAD ───────────────────────────────────────────── -->
  <section class="py-20 bg-[var(--color-surface)] border-t border-[var(--color-border)]" aria-labelledby="cobertura-heading">
    <div class="mx-auto max-w-6xl px-6 sm:px-10 lg:px-14">
      <div class="reveal grid gap-12 lg:grid-cols-2 lg:gap-20 items-center">
        <div>
          <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-primary)]">{isEs ? 'Empresa local' : 'Empresa local'}</p>
          <h2 id="cobertura-heading" class="font-display text-3xl font-bold text-[var(--color-foreground)] sm:text-4xl mb-6">
            NaturLimp {isEs ? `en ${city}` : `a ${city}`}
          </h2>
          <div class="space-y-4 text-[var(--color-muted-fg)] leading-relaxed">
            {isEs ? (
              <>
                <p>Somos una empresa de limpieza con base en Tarragona que presta servicio regular en {city}, {proximityText}. Nuestros equipos se desplazan de forma habitual a la zona, lo que nos permite ofrecer los mismos tiempos de respuesta y estándares de calidad que en nuestra ciudad.</p>
                <p>Trabajamos con equipo propio — sin subcontratas —, maquinaria profesional y productos con certificación ecológica cuando el servicio lo permite. Todos los trabajos están cubiertos por seguro de responsabilidad civil.</p>
                <p>Si tienes una comunidad de vecinos, una piscina comunitaria, necesitas una limpieza final de obra o buscas mantenimiento para tu oficina en {city}, contacta con nosotros y te enviamos presupuesto en menos de 24 horas.</p>
              </>
            ) : (
              <>
                <p>Som una empresa de neteja amb base a Tarragona que presta servei regular a {city}, {proximityText}. Els nostres equips es desplacen habitualment a la zona, cosa que ens permet oferir els mateixos temps de resposta i estàndards de qualitat que a la nostra ciutat.</p>
                <p>Treballem amb equip propi — sense subcontractes —, maquinària professional i productes amb certificació ecològica quan el servei ho permet. Tots els treballs estan coberts per assegurança de responsabilitat civil.</p>
                <p>Si tens una comunitat de veïns, una piscina comunitària, necessites una neteja final d'obra o busques manteniment per a la teva oficina a {city}, contacta'ns i t'enviem pressupost en menys de 24 hores.</p>
              </>
            )}
          </div>
        </div>
        <div class="reveal flex flex-col gap-4">
          {[
            {
              icon: `<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>`,
              title: isEs ? `${distanceKm} km desde Tarragona` : `${distanceKm} km des de Tarragona`,
              desc: isEs ? 'Desplazamiento incluido en nuestras tarifas para servicios regulares' : 'Desplaçament inclòs en les nostres tarifes per a serveis regulars'
            },
            {
              icon: `<path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m9 12 2 2 4-4"/>`,
              title: isEs ? 'Equipo propio certificado' : 'Equip propi certificat',
              desc: isEs ? 'Sin subcontratas. Personal formado, con seguro y experiencia acreditada' : 'Sense subcontractes. Personal format, amb assegurança i experiència acreditada'
            },
            {
              icon: `<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/>`,
              title: isEs ? 'Presupuesto en 24 horas' : 'Pressupost en 24 hores',
              desc: isEs ? 'Detallado, sin letra pequeña ni costes ocultos. Sin compromiso.' : 'Detallat, sense lletra petita ni costos ocults. Sense compromís.'
            },
          ].map(({ icon, title, desc }) => (
            <div class="flex items-start gap-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-background)] p-5">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-[var(--color-primary)]/10 text-[var(--color-primary)]" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={icon} />
              </span>
              <div>
                <p class="font-heading font-semibold text-[var(--color-foreground)] text-sm">{title}</p>
                <p class="mt-1 text-xs text-[var(--color-muted-fg)] leading-relaxed">{desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── FAQ ───────────────────────────────────────────────────────────────── -->
  <section class="py-20 bg-[var(--color-background)]" aria-labelledby="faq-heading">
    <div class="mx-auto max-w-4xl px-6 sm:px-10 lg:px-14">
      <div class="reveal mb-12 text-center">
        <p class="mb-2 text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-primary)]">{isEs ? 'Preguntas frecuentes' : 'Preguntes freqüents'}</p>
        <h2 id="faq-heading" class="font-display text-3xl font-bold text-[var(--color-foreground)] sm:text-4xl">
          {isEs ? `Limpieza en ${city}: dudas habituales` : `Neteja a ${city}: dubtes habituals`}
        </h2>
      </div>
      <dl class="reveal space-y-4">
        {faqItems.map(({ q, a }) => (
          <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
            <dt class="font-heading font-semibold text-[var(--color-foreground)]">{q}</dt>
            <dd class="mt-3 text-sm text-[var(--color-muted-fg)] leading-relaxed">{a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ── CONTACT FORM ───────────────────────────────────────────────────────── -->
  <section id={contactId} class="relative py-24 bg-[var(--color-foreground)] overflow-hidden" aria-labelledby="cta-heading">
    <div class="pointer-events-none absolute inset-0" style="background:radial-gradient(ellipse 55% 70% at 10% 60%, rgba(21,128,61,0.18) 0%, transparent 65%);" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-6 sm:px-10 lg:px-14">
      <div class="grid grid-cols-1 gap-16 lg:grid-cols-2 lg:gap-20">

        <div class="reveal flex flex-col justify-center">
          <div class="mb-6 inline-flex w-fit items-center gap-2 rounded-sm border border-[var(--color-primary)]/40 bg-[var(--color-primary)]/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--color-primary-light)]">
