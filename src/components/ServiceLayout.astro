---
import ContactForm from './ContactForm';
import Button from './Button';

export interface GalleryItem {
  src: string;
  alt: string;
  caption?: string;
}

export interface ServiceStat {
  value: string;
  label: string;
}

interface Props {
  headline: string;
  subheadline: string;
  serviceTag: string;
  serviceNum: string;
  breadcrumb: string;
  checklist: string[];
  gallery: GalleryItem[];
  stats: ServiceStat[];
  zonesText: string;
  zones: string[];
  t: any;
  lang: 'es' | 'ca';
}

const { headline, subheadline, serviceTag, serviceNum, breadcrumb, checklist, gallery, stats, zonesText, zones, t, lang } = Astro.props;

const isEs = lang === 'es';
const contactId = isEs ? 'contacto' : 'contacte';

const L = {
  home:       isEs ? 'Inicio'                               : 'Inici',
  services:   isEs ? 'Servicios'                            : 'Serveis',
  gallery:    isEs ? 'Galería de trabajos'                  : 'Galeria de treballs',
  gallerySub: isEs ? 'Resultados reales, clientes reales'   : 'Resultats reals, clients reals',
  includes:   isEs ? '¿Qué incluye el servicio?'            : 'Què inclou el servei?',
  process:    isEs ? 'Cómo trabajamos'                      : 'Com treballem',
  processSub: isEs ? 'Simple, transparente, sin sorpresas'  : 'Simple, transparent, sense sorpreses',
  zones:      isEs ? 'Zona de cobertura'                    : 'Zona de cobertura',
  ctaTitle:   isEs ? 'Pide presupuesto sin compromiso'      : 'Demana pressupost sense compromís',
  ctaSub:     isEs ? 'Te respondemos en menos de 24 horas.' : 'Et responem en menys de 24 hores.',
  ctaBtn:     isEs ? 'Solicitar presupuesto gratis'         : 'Sol·licitar pressupost gratis',
  tel:        isEs ? 'Teléfono'                             : 'Telèfon',
  waLabel:    isEs ? 'Escríbenos directamente'              : "Escriu-nos directament",
};

const steps = isEs ? [
  {
    title: 'Contacta con nosotros',
    desc:  'Llámanos, mándanos un WhatsApp o rellena el formulario. Cuéntanos qué necesitas y cuándo.',
    icon:  `<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.99 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.9 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>`,
  },
  {
    title: 'Valoración gratuita',
    desc:  'Visitamos el espacio, evaluamos el trabajo y te enviamos un presupuesto detallado en menos de 24 h.',
    icon:  `<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>`,
  },
  {
    title: 'Ejecutamos el servicio',
    desc:  'Nuestro equipo propio, con maquinaria profesional y seguros al día, realiza el trabajo sin sorpresas.',
    icon:  `<path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m9 12 2 2 4-4"/>`,
  },
] : [
  {
    title: "Contacta amb nosaltres",
    desc:  "Truca'ns, envia'ns un WhatsApp o omple el formulari. Explica'ns què necessites i quan.",
    icon:  `<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.99 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.9 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>`,
  },
  {
    title: 'Valoració gratuïta',
    desc:  "Visitem l'espai, avaluem la feina i t'enviem un pressupost detallat en menys de 24 h.",
    icon:  `<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>`,
  },
  {
    title: 'Executem el servei',
    desc:  "El nostre equipo propi, amb maquinària professional i assegurances al dia, realitza la feina sense sorpreses.",
    icon:  `<path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m9 12 2 2 4-4"/>`,
  },
];
---

<article>

  <!-- ── HERO ──────────────────────────────────────────────────────────────── -->
  <section class="relative overflow-hidden bg-[var(--color-foreground)] text-white">
    <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[var(--color-primary)] to-transparent" aria-hidden="true"></div>
    <div class="absolute inset-0 pointer-events-none" style="background-image:linear-gradient(rgba(255,255,255,0.018) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.018) 1px,transparent 1px);background-size:52px 52px;" aria-hidden="true"></div>
    <div class="absolute right-0 top-1/2 -translate-y-1/2 pointer-events-none select-none overflow-hidden" aria-hidden="true">
      <span class="block font-display font-bold leading-none text-white" style="font-size:clamp(160px,22vw,380px);opacity:0.04;">{serviceNum}</span>
    </div>

    <div class="relative z-10 mx-auto max-w-6xl px-6 py-24 sm:px-10 lg:px-14">
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 text-xs uppercase tracking-widest text-white/30">
          <li><a href="/" class="hover:text-white/60 transition-colors">{L.home}</a></li>
          <li aria-hidden="true" class="text-white/20">›</li>
          <li><a href="/#servicios" class="hover:text-white/60 transition-colors">{L.services}</a></li>
          <li aria-hidden="true" class="text-white/20">›</li>
          <li aria-current="page" class="text-white/50">{breadcrumb}</li>
        </ol>
      </nav>

      <div class="mb-6">
        <span class="inline-flex items-center gap-2 rounded-sm border border-[var(--color-primary)]/40 bg-[var(--color-primary)]/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--color-primary-light)]">
          <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-primary)]" aria-hidden="true"></span>
          {serviceTag}
        </span>
      </div>

      <h1 class="font-display font-bold tracking-tight" style="font-size:clamp(2rem,6vw,4.5rem);line-height:1.05;max-width:20ch;">{headline}</h1>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-white/50">{subheadline}</p>

      <div class="mt-10 flex flex-wrap items-center gap-4">
        <Button
          client:load
          as="a"
          href={`#${contactId}`}
          variant="primary"
          size="lg"
          className="w-full sm:w-auto"
        >
          {L.ctaBtn}
        </Button>
        <Button
          client:load
          as="a"
          href="tel:+34977000000"
          variant="secondary"
          size="lg"
          className="w-full sm:w-auto !text-white !border-white/20 hover:!bg-white hover:!text-[var(--color-primary)]"
        >
          977 000 000
        </Button>
      </div>

      <div class="mt-12 flex flex-wrap gap-x-8 gap-y-3">
        {stats.map(({ value, label }) => (
          <div class="flex items-baseline gap-2">
            <span class="font-display text-2xl font-bold text-[var(--color-primary-light)]">{value}</span>
            <span class="text-sm text-white/30">{label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── GALLERY ────────────────────────────────────────────────────────────── -->
  <section class="py-20 bg-[var(--color-background)]" aria-labelledby="gallery-heading">
    <div class="mx-auto max-w-6xl px-6 sm:px-10 lg:px-14">
      <div class="reveal mb-12 flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="mb-2 text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-primary)]">{L.gallery}</p>
          <h2 id="gallery-heading" class="font-display text-3xl font-bold text-[var(--color-foreground)] sm:text-4xl">{L.gallerySub}</h2>
        </div>
        <p class="text-sm text-[var(--color-muted-fg)]">Tarragona · Costa Daurada</p>
      </div>

      <div class="reveal gallery-grid">
        {gallery.slice(0, 4).map(({ src, alt, caption }, i) => (
          <div class={`gallery-item gallery-item-${i + 1} group relative overflow-hidden rounded-xl bg-[var(--color-muted)]`}>
            <img src={src} alt={alt} loading="lazy" decoding="async"
              class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" />
            {caption && (
              <div class="absolute inset-x-0 bottom-0 translate-y-full bg-gradient-to-t from-black/80 to-transparent px-4 py-4 transition-transform duration-300 group-hover:translate-y-0">
                <p class="text-sm font-medium text-white">{caption}</p>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CHECKLIST ──────────────────────────────────────────────────────────── -->
  <section class="py-20 bg-[var(--color-surface)] border-t border-[var(--color-border)]" aria-labelledby="includes-heading">
    <div class="mx-auto max-w-6xl px-6 sm:px-10 lg:px-14">
      <div class="reveal mb-12">
        <p class="mb-2 text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-primary)]">Servicio completo</p>
        <h2 id="includes-heading" class="font-display text-3xl font-bold text-[var(--color-foreground)] sm:text-4xl">{L.includes}</h2>
      </div>
      <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2" role="list">
        {checklist.map((item, i) => (
          <li class="reveal check-item flex items-start gap-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-background)] p-5 transition-all duration-200 hover:border-[var(--color-primary)]/30 hover:shadow-sm" style={`transition-delay:${i * 35}ms`}>
            <span class="mt-0.5 flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-[var(--color-primary)]/10 text-[var(--color-primary)]" aria-hidden="true">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth={3} strokeLinecap="round">
                <path d="m9 12 2 2 4-4"/>
              </svg>
            </span>
            <span class="text-[var(--color-muted-fg)]">{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── PROCESS ────────────────────────────────────────────────────────────── -->
  <section class="py-20 bg-[var(--color-foreground)] text-white" aria-labelledby="process-heading">
    <div class="mx-auto max-w-6xl px-6 sm:px-10 lg:px-14">
      <div class="reveal mb-16">
        <p class="mb-2 text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-primary-light)]/50">{L.process}</p>
        <h2 id="process-heading" class="font-display text-3xl font-bold sm:text-4xl">{L.processSub}</h2>
      </div>

      <div class="process-grid relative">
        <div class="process-line" aria-hidden="true"></div>
        {steps.map(({ title, desc, icon }, i) => (
          <div class="reveal" style={`transition-delay:${i * 80}ms`}>
            <div class="mb-4 flex items-center gap-4 sm:flex-col sm:items-start sm:gap-3">
              <span class="font-display text-5xl font-bold leading-none text-[var(--color-primary)]">{String(i + 1).padStart(2, '0')}</span>
              <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-[var(--color-primary)]/15 text-[var(--color-primary-light)]">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth={1.75} strokeLinecap="round" strokeLinejoin="round" aria-hidden="true" set:html={icon} />
              </span>
            </div>
            <h3 class="font-heading text-lg font-semibold">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/45">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── ZONES ──────────────────────────────────────────────────────────────── -->
  <section class="py-20 bg-[var(--color-background)]" aria-labelledby="zones-heading">
    <div class="mx-auto max-w-6xl px-6 sm:px-10 lg:px-14">
      <div class="reveal mb-8">
        <p class="mb-2 text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-primary)]">{L.zones}</p>
        <h2 id="zones-heading" class="font-display text-3xl font-bold text-[var(--color-foreground)] sm:text-4xl">Tarragona y comarca</h2>
      </div>
      <div class="reveal grid gap-8 lg:grid-cols-2 lg:gap-16 items-start">
        <p class="text-[var(--color-muted-fg)] leading-relaxed">{zonesText}</p>
        <div class="flex flex-wrap gap-2">
          {zones.map(zone => (
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-1.5 text-sm text-[var(--color-muted-fg)]">
              <svg width="7" height="7" viewBox="0 0 10 10" fill="currentColor" class="text-[var(--color-primary)]" aria-hidden="true"><circle cx="5" cy="5" r="5"/></svg>
              {zone}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── CONTACT FORM ───────────────────────────────────────────────────────── -->
  <section id={contactId} class="relative py-24 bg-[var(--color-foreground)] overflow-hidden" aria-labelledby="cta-heading">
    <div class="pointer-events-none absolute inset-0" style="background:radial-gradient(ellipse 55% 70% at 10% 60%, rgba(21,128,61,0.18) 0%, transparent 65%);" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-6 sm:px-10 lg:px-14">
      <div class="grid grid-cols-1 gap-16 lg:grid-cols-2 lg:gap-20">

        <div class="reveal flex flex-col justify-center">
          <div class="mb-6 inline-flex w-fit items-center gap-2 rounded-sm border border-[var(--color-primary)]/40 bg-[var(--color-primary)]/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--color-primary-light)]">
            <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-primary)]" aria-hidden="true"></span>
            Presupuesto gratuito
          </div>
          <h2 id="cta-heading" class="font-display text-4xl font-bold text-white sm:text-5xl" style="line-height:1.05">{L.ctaTitle}</h2>
          <p class="mt-5 text-lg leading-relaxed text-white/45">{L.ctaSub}</p>
          <div class="mt-10 space-y-3">
            <Button
              client:load
              as="a"
              href="tel:+34977000000"
              variant="secondary"
              className="group !justify-start !h-auto !px-6 !py-4 !rounded-xl !bg-white/[0.04] !border-white/8 hover:!border-[var(--color-primary)]/40 transition-colors"
            >
              <div>
                <span class="block text-[11px] uppercase tracking-widest text-white/35 text-left">{L.tel}</span>
                <span class="block text-sm font-semibold text-white text-left">977 000 000</span>
              </div>
            </Button>
            <Button
              client:load
              as="a"
              href="https://wa.me/34977000000?text=Hola%2C%20me%20gustar%C3%ADa%20pedir%20un%20presupuesto"
              target="_blank"
              rel="noopener noreferrer"
              variant="secondary"
              className="group !justify-start !h-auto !px-6 !py-4 !rounded-xl !bg-white/[0.04] !border-white/8 hover:!border-[var(--color-primary)]/40 transition-colors"
            >
              <div>
                <span class="block text-[11px] uppercase tracking-widest text-white/35 text-left">WhatsApp</span>
                <span class="block text-sm font-semibold text-white text-left">{L.waLabel}</span>
              </div>
            </Button>
          </div>
          <div class="mt-10 border-t border-white/8 pt-8 flex flex-col gap-2.5">
            {[
              isEs ? 'Respuesta en menos de 24 horas'                 : 'Resposta en menys de 24 hores',
              isEs ? 'Presupuesto sin compromiso'                      : 'Pressupost sense compromís',
              isEs ? 'Cobertura en toda la provincia de Tarragona'    : 'Cobertura a tota la província de Tarragona',
            ].map(s => (
              <span class="flex items-center gap-2.5 text-sm text-white/30">
                <span class="h-px w-4 flex-shrink-0 bg-[var(--color-primary)]" aria-hidden="true"></span>
                {s}
              </span>
            ))}
          </div>
        </div>

        <div class="reveal rounded-2xl bg-white p-8 shadow-2xl lg:p-10">
          <ContactForm client:visible t={t.contact} lang={lang} />
        </div>
      </div>
    </div>
  </section>

</article>

<style>
  /* Gallery */
  .gallery-grid {
    display: grid;
    gap: 0.625rem;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 190px 190px;
  }
  .gallery-item { border-radius: 0.75rem; overflow: hidden; }
  .gallery-item-1 { grid-column: 1; grid-row: 1 / 3; }
  .gallery-item-2 { grid-column: 2; grid-row: 1; }
  .gallery-item-3 { grid-column: 2; grid-row: 2; }
  .gallery-item-4 { display: none; }

  @media (min-width: 768px) {
    .gallery-grid {
      grid-template-columns: 2fr 1fr 1fr;
      grid-template-rows: 280px 280px;
    }
    .gallery-item-1 { grid-column: 1; grid-row: 1 / 3; }
    .gallery-item-2 { grid-column: 2; grid-row: 1; }
    .gallery-item-3 { grid-column: 3; grid-row: 1; }
    .gallery-item-4 { display: block; grid-column: 2 / 4; grid-row: 2; }
  }

  /* Process steps */
  .process-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  .process-line { display: none; }

  @media (min-width: 640px) {
    .process-grid { grid-template-columns: repeat(3, 1fr); gap: 2rem; }
    .process-line {
      display: block;
      position: absolute;
      top: 1.6rem;
      left: calc(100% / 6 + 1.5rem);
      right: calc(100% / 6 + 1.5rem);
      height: 1px;
      background: linear-gradient(to right, transparent, rgba(21,128,61,0.22), transparent);
    }
  }

  /* Reveal */
  .reveal {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }
  .reveal.visible { opacity: 1; transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  const io = new IntersectionObserver(
    es => es.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); }),
    { threshold: 0.08 }
  );
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));
</script>
