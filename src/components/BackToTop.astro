---
interface Props {
  lang: 'es' | 'ca';
}
const { lang } = Astro.props;
---

<button
  id="back-to-top"
  aria-label={lang === 'es' ? 'Volver arriba' : 'Tornar amunt'}
  class="btt-btn"
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M18 15l-6-6-6 6"/>
  </svg>
</button>

<style>
  .btt-btn {
    position: fixed;
    right: 1.25rem;
    bottom: calc(5.75rem + env(safe-area-inset-bottom));
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    background-color: var(--color-primary);
    color: white;
    box-shadow: 0 4px 20px oklch(from var(--color-primary) l c h / 0.35);
    cursor: pointer;
    border: none;
    outline-offset: 3px;
    opacity: 0;
    transform: translateY(0.6rem);
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease, background-color 0.15s, scale 0.15s;
  }

  @media (min-width: 768px) {
    .btt-btn { bottom: 2rem; }
  }

  .btt-btn.visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .btt-btn:hover  { background-color: var(--color-primary-dark); scale: 1.08; }
  .btt-btn:active { scale: 0.95; }
  .btt-btn:focus-visible { outline: 2px solid var(--color-primary); }
</style>

<script>
  const btn = document.getElementById('back-to-top');
  if (btn) {
    let rafId = 0;
    window.addEventListener('scroll', () => {
      if (rafId) cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(() => {
        btn.classList.toggle('visible', window.scrollY > 420);
      });
    }, { passive: true });

    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>
