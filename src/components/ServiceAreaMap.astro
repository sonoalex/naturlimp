---
interface Props {
  title: string;
  subtitle: string;
  lang: 'es' | 'ca';
}

const { title, subtitle, lang } = Astro.props;

const zones = ['Tarragona', 'Reus', 'Salou', 'Cambrils', 'Vila-seca', 'Torredembarra', 'Constantí', 'La Canonja', 'Altafulla', 'El Vendrell', 'Calafell', 'Valls'];
---

<section class="bg-[var(--color-primary)]" aria-labelledby="map-heading">
  <div class="mx-auto max-w-7xl px-6 pt-16 pb-10 sm:px-10 lg:px-14">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
      <h2 id="map-heading" class="font-display text-4xl font-bold tracking-tight text-white sm:text-5xl">
        {title}
      </h2>
      <p class="max-w-xs text-sm text-white/60 sm:text-right">{subtitle}</p>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-6 pb-0 sm:px-10 lg:px-14">
    <div class="overflow-hidden rounded-xl aspect-[16/6] shadow-2xl">
      <iframe
        title={lang === 'es' ? 'Mapa zona de servicio NaturLimp — Tarragona 30km' : 'Mapa zona de servei NaturLimp — Tarragona 30km'}
        width="100%"
        height="100%"
        style="border:0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        src="https://www.google.com/maps/embed?pb=!1m14!1m12!1m3!1d62000!2d1.2445!3d41.1189!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!5e0!3m2!1ses!2ses"
        aria-label={lang === 'es' ? 'Mapa de Tarragona y la zona de servicio de 30km' : 'Mapa de Tarragona i la zona de servei de 30km'}
      ></iframe>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-6 py-8 sm:px-10 lg:px-14">
    <ul
      class="flex flex-wrap gap-2"
      aria-label={lang === 'es' ? 'Municipios cubiertos' : 'Municipis coberts'}
      role="list"
    >
      {zones.map(city => (
        <li class="rounded-sm border border-white/20 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-white/70">
          {city}
        </li>
      ))}
    </ul>
  </div>
</section>
