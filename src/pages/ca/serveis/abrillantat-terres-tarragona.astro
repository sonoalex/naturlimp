---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ServiceLayout from '../../../components/ServiceLayout.astro';
import { flattenI18n } from '../../../utils/i18n';

const rawT = await import('../../../i18n/ca.json');
const t = rawT.default;
const flat = flattenI18n(t as unknown as Record<string, unknown>);

const checklist = [
  'Decapat i neteja profunda de la superfície',
  'Aplicació de líquid cristal·litzador professional',
  'Abrillantat amb màquina rotativa d\'alta velocitat',
  'Tractament antilliscant per a major seguretat',
  'Segellat de porus en marbre i terratzo',
  'Protecció contra taques i desgast',
  'Acabat mirall de llarga durada',
];

const stats = [
  { value: 'Mirall', label: 'Acabat' },
  { value: 'Pro', label: 'Maquinària' },
  { value: 'SENSE', label: 'Pols' },
];

const gallery = [
  { src: 'https://picsum.photos/seed/nl-ca-floor1/800/600', alt: 'Abrillantat de marbre', caption: 'Resultats mirall' },
  { src: 'https://picsum.photos/seed/nl-ca-floor2/800/600', alt: 'Terratzo polit', caption: 'Recuperació de lluentor' },
];

const zones = ['Tarragona', 'Reus', 'Salou', 'Cambrils', 'Valls', 'El Vendrell'];
---

<BaseLayout
  title="Abrillantat de terres a Tarragona | NaturLimp"
  description="Servei professional d'abrillantat i cristal·litzat de terres de marbre i terratzo a Tarragona i Reus. Recuperi la lluentor del seu terra."
  lang="ca"
>
  <Header lang="ca" t={flat} />
  
  <main id="main-content">
    <ServiceLayout
      lang="ca"
      t={t}
      serviceNum="04"
      serviceTag="Especialitzat"
      breadcrumb="Abrillantat de terres"
      headline="Abrillantat i cristal·litzat de terres"
      subheadline="Recuperem la lluentor original del seu terra de marbre o terratzo amb tractaments professionals que protegeixen la superfície."
      checklist={checklist}
      stats={stats}
      gallery={gallery}
      zones={zones}
      zonesText="Treballem per a particulars, comunitats i locals comercials a tota la província. Utilitzem productes d'alta qualitat que no deixen pols ni olors."
    />
  </main>

  <Footer lang="ca" t={flat} />
</BaseLayout>
