---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ServiceLayout from '../../../components/ServiceLayout.astro';
import { flattenI18n } from '../../../utils/i18n';

const rawT = await import('../../../i18n/ca.json');
const t = rawT.default;
const flat = flattenI18n(t as unknown as Record<string, unknown>);

const checklist = [
  'Neteja del vas de la piscina i fons',
  'Control i regulació de pH i clor/sal',
  'Neteja de filtres, skimmers i prefiltres',
  'Neteja del recinte, dutxes i zones de pas',
  'Subministrament de productes químics',
  'Preparació per a la temporada de bany',
  'Manteniment preventiu durant l\'hivern',
];

const stats = [
  { value: 'Cristal', label: 'Aigua' },
  { value: 'Sal/Cl', label: 'Tractament' },
  { value: 'PRO', label: 'Químics' },
];

const gallery = [
  { src: 'https://picsum.photos/seed/nl-ca-pool1/800/600', alt: 'Manteniment de piscines', caption: 'Aigües cristal·lines' },
  { src: 'https://picsum.photos/seed/nl-ca-pool2/800/600', alt: 'Piscina comunitària neta', caption: 'Espais segurs' },
];

const zones = ['Tarragona', 'Reus', 'Salou', 'Cambrils', 'Vila-seca', 'Torredembarra'];
---

<BaseLayout
  title="Manteniment de piscines a Tarragona | NaturLimp"
  description="Servei professional de neteja i manteniment de piscines comunitàries i privades a Tarragona, Salou i Cambrils. Aigua cristal·lina tot l'any."
  lang="ca"
>
  <Header lang="ca" t={flat} />
  
  <main id="main-content">
    <ServiceLayout
      lang="ca"
      t={t}
      serviceNum="02"
      serviceTag="Manteniment"
      breadcrumb="Piscines comunitàries"
      headline="Neteja i manteniment de piscines"
      subheadline="Garantim una aigua sana i cristal·lina durant tota la temporada amb tractaments professionals i un control rigorós dels paràmetres."
      checklist={checklist}
      stats={stats}
      gallery={gallery}
      zones={zones}
      zonesText="Especialistes en piscines de comunitats de veïns a la Costa Daurada. Ens encarreguem de tot perquè vostès només hagin de gaudir del bany."
    />
  </main>

  <Footer lang="ca" t={flat} />
</BaseLayout>
