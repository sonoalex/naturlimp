---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ServiceLayout from '../../../components/ServiceLayout.astro';
import { flattenI18n } from '../../../utils/i18n';

const rawT = await import('../../../i18n/ca.json');
const t = rawT.default;
const flat = flattenI18n(t as unknown as Record<string, unknown>);

const checklist = [
  'Neteja de vidres interiors i exteriors',
  'Neteja profunda de marcs i guies',
  'Eliminació de calç, greix i adhesius',
  'Neteja de vidres de difícil accés',
  'Neteja de mampares i miralls',
  'Manteniment de vidrieres comercials',
  'Acabat sense rastres ni marques',
];

const stats = [
  { value: '100%', label: 'Transparència' },
  { value: 'RAPID', label: 'Servei' },
  { value: 'Tots', label: 'Vidres' },
];

const gallery = [
  { src: 'https://picsum.photos/seed/nl-ca-glass1/800/600', alt: 'Neteja de vidres', caption: 'Transparència total' },
  { src: 'https://picsum.photos/seed/nl-ca-glass2/800/600', alt: 'Vidres de local net', caption: 'Imatge impecable' },
];

const zones = ['Tarragona', 'Reus', 'Salou', 'Cambrils', 'Vila-seca', 'Torredembarra', 'Altafulla'];
---

<BaseLayout
  title="Neteja de vidres a Tarragona | NaturLimp"
  description="Servei professional de neteja de vidres a Tarragona per a domicilis, oficines i locals comercials. Resultats impecables sense marques."
  lang="ca"
>
  <Header lang="ca" t={flat} />
  
  <main id="main-content">
    <ServiceLayout
      lang="ca"
      t={t}
      serviceNum="05"
      serviceTag="Especialitzat"
      heroImage="https://images.unsplash.com/photo-1541336032412-2048a678540d?q=80&w=2000&auto=format&fit=crop"
      breadcrumb="Neteja de vidres"
      headline="Neteja de vidres i vidrieres"
      subheadline="Deixem els seus vidres completament transparents i sense marques, utilitzant les millors tècniques i eines professionals."
      checklist={checklist}
      stats={stats}
      gallery={gallery}
      zones={zones}
      zonesText="Donem servei a tota la província de Tarragona, tant per a manteniments periòdics com per a neteges puntuals de fi d'obra o reformes."
    />
  </main>

  <Footer lang="ca" t={flat} />
</BaseLayout>
