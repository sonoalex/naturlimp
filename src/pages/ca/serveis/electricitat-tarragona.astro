---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ServiceLayout from '../../../components/ServiceLayout.astro';
import { flattenI18n } from '../../../utils/i18n';

const rawT = await import('../../../i18n/ca.json');
const t = rawT.default;
const flat = flattenI18n(t as unknown as Record<string, unknown>);

const checklist = [
  'Manteniment preventiu i correctiu de la xarxa elèctrica comunitària',
  'Substitució i migració a il·luminació LED de baix consum amb sensors de presència',
  'Reparació i instal·lació d\'intèrfons i videoporters digitals',
  'Revisió, adequació i canvi de quadres elèctrics i interruptors diferencials',
  'Instal·lació i revisió de llums d\'emergència homologats i sistemes de senyalització',
  'Detecció i resolució de curtcircuits, derivacions i caigudes de tensió',
  'Instal·lació i manteniment de punts de recàrrega per a vehicles elèctrics en pàrquings',
  'Emissió de butlletins elèctrics i certificats d\'instal·lació elèctrica (CIE)',
];

const stats = [
  { value: '15', label: 'anys d\'experiència' },
  { value: '100%', label: 'electricistes autoritzats' },
  { value: '30 km', label: 'radi de servei' },
  { value: '24 h', label: 'temps de resposta' },
];

const gallery = [
  { src: 'https://picsum.photos/seed/nl-elec-1/600/820', alt: 'Quadre elèctric general instal·lat amb diferencials', caption: 'Quadres elèctrics comunitaris homologats' },
  { src: 'https://picsum.photos/seed/nl-elec-2/500/400', alt: 'Il·luminació LED amb sensor de presència a l\'escala', caption: 'Il·luminació LED de baix consum' },
  { src: 'https://picsum.photos/seed/nl-elec-3/500/400', alt: 'Videoporter digital instal·lat al portal', caption: 'Videoporters d\'última generació' },
  { src: 'https://picsum.photos/seed/nl-elec-4/900/520', alt: 'Punt de recàrrega de cotxe elèctric en pàrquing comunitari', caption: 'Punts de recàrrega per a vehicles' },
];

const zones = ['Tarragona', 'Reus', 'Salou', 'Cambrils', 'Vila-seca', 'Torredembarra', 'Altafulla', 'Constantí', 'Valls'];
---

<BaseLayout
  title="Serveis d'electricitat i instal·lacions a Tarragona | NaturLimp"
  description="Instal·lacions elèctriques i manteniment per a comunitats, comerços i habitatges a Tarragona. Il·luminació LED, butlletins, quadres i avaries. Demana pressupost."
  lang="ca"
  canonical="https://naturlimp.com/ca/serveis/electricitat-tarragona/"
>
  <Header lang="ca" t={flat} />
  
  <main id="main-content">
    <ServiceLayout
      lang="ca"
      t={t}
      heroImage="https://images.unsplash.com/photo-1621905251189-08b45d6a269e?q=80&w=2000&auto=format&fit=crop"
      serviceNum="07"
      serviceTag="Electricitat · Il·luminació LED · Avaries"
      breadcrumb="Electricitat"
      headline="Electricitat i manteniment d'instal·lacions a Tarragona"
      subheadline="Instal·ladors electricistes autoritzats per a comunitats de propietaris, empreses i particulars. Estalvi energètic, reparacions ràpides i màxima seguretat normativa."
      checklist={checklist}
      stats={stats}
      gallery={gallery}
      zones={zones}
      zonesText="Serveis d'electricitat i instal·lacions a tota la ciutat de Tarragona, Reus, Salou, Cambrils, Vila-seca, Torredembarra, Altafulla, Constantí i resta del Tarragonès i Baix Camp."
    />
  </main>
  
  <Footer lang="ca" t={flat} />
</BaseLayout>
