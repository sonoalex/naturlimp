---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ContactForm from '../../../components/ContactForm';
import { flattenI18n } from '../../../utils/i18n';

const rawT = await import('../../../i18n/ca.json');
const t = rawT.default;
const flat = flattenI18n(t as unknown as Record<string, unknown>);
---

<BaseLayout
  title="Neteja de final d'obra a Tarragona | NaturLimp"
  description="Neteja professional de final d'obra a Tarragona, Reus i Costa Daurada. Retirem pols, restes de pintura i residus en habitatges, locals i comunitats. Pressupost sense compromís."
  lang="ca"
  canonical="https://naturlimp.com/ca/serveis/neteja-final-obra-tarragona"
>
  <Header lang="ca" t={flat} />

  <main id="main-content">
    <article class="py-20 bg-[var(--color-background)]">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">

        <header class="mb-12">
          <nav aria-label="Breadcrumb" class="mb-4">
            <ol class="flex items-center gap-2 text-sm text-[var(--color-muted-fg)]">
              <li><a href="/ca" class="hover:text-[var(--color-primary)]">Inici</a></li>
              <li aria-hidden="true">›</li>
              <li><a href="/ca#serveis" class="hover:text-[var(--color-primary)]">Serveis</a></li>
              <li aria-hidden="true">›</li>
              <li aria-current="page" class="text-[var(--color-foreground)]">Neteja de final d'obra</li>
            </ol>
          </nav>
          <h1 class="font-heading text-4xl font-bold text-[var(--color-foreground)] sm:text-5xl">
            Neteja de final d'obra a Tarragona i Costa Daurada
          </h1>
          <p class="mt-6 text-lg text-[var(--color-muted-fg)] leading-relaxed">
            Neteja exhaustiva després de reformes, obra nova i rehabilitacions a Tarragona, Reus, Salou, Cambrils i tota la comarca. Pols d'obra, restes de pintura, guix i residus eliminats abans del lliurament o la mudança. Equip propi amb maquinària especialitzada.
          </p>
        </header>

        <section aria-labelledby="service-details">
          <h2 id="service-details" class="font-heading text-2xl font-semibold text-[var(--color-foreground)] mb-6">Què inclou el servei?</h2>
          <ul class="space-y-3 text-[var(--color-muted-fg)]">
            {[
              'Retirada de pols d\'obra en sostres, parets i superfícies',
              'Neteja de finestres, marcs, persianes i premarcs',
              'Eliminació de restes de pintura, guix, morter i adhesius',
              'Neteja a fons de cuina, banys i zones humides',
              'Aspirat i fregat de terres i rajoles',
              'Neteja interior d\'armaris encastats, fusteries i ferraments',
              'Recollida i gestió de residus d\'obra',
              'Abrillantat o cristal·litzat de terres si es sol·licita',
            ].map(item => (
              <li class="flex items-start gap-3">
                <svg class="mt-0.5 flex-shrink-0 text-[var(--color-accent)]" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </section>

        <section class="mt-12" aria-labelledby="zones-heading">
          <h2 id="zones-heading" class="font-heading text-2xl font-semibold text-[var(--color-foreground)] mb-4">
            Zones de servei a Tarragona i comarca
          </h2>
          <p class="text-[var(--color-muted-fg)]">
            Realitzem neteges de final d'obra a <strong>Tarragona</strong> (Part Alta, Eixample, Serrallo, Campclar), <strong>Reus</strong>, <strong>Salou</strong>, <strong>Cambrils</strong>, <strong>Vila-seca</strong>, <strong>Torredembarra</strong>, <strong>El Vendrell</strong> i tots els municipis en un radi de 30 km. Habitatges, locals comercials, comunitats i naus industrials.
          </p>
        </section>

        <section class="mt-12 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-8" aria-labelledby="cta-form">
          <h2 id="cta-form" class="font-heading text-2xl font-semibold text-[var(--color-foreground)] mb-2">
            Sol·licita pressupost sense compromís
          </h2>
          <p class="mb-6 text-[var(--color-muted-fg)]">Et responem en menys de 24 hores.</p>
          <ContactForm client:visible t={t.contact} lang="ca" />
        </section>

      </div>
    </article>
  </main>

  <Footer lang="ca" t={flat} />
</BaseLayout>
