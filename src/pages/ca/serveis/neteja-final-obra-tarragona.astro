---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ServiceLayout from '../../../components/ServiceLayout.astro';
import { flattenI18n } from '../../../utils/i18n';

const rawT = await import('../../../i18n/ca.json');
const t = rawT.default;
const flat = flattenI18n(t as unknown as Record<string, unknown>);

const checklist = [
  'Eliminació de restes de pintura, ciment i silicona',
  'Aspirat industrial de pols en totes les superfícies',
  'Neteja profunda de marcs, portes i finestres',
  'Desinfecció de banys i cuines complets',
  'Neteja interior i exterior d\'armaris i calaixos',
  'Neteja de vidres, miralls i superfícies metàl·liques',
  'Fregat final de terres amb productes específics',
];

const stats = [
  { value: '24h', label: 'Lliurament' },
  { value: '100%', label: 'Garantit' },
  { value: 'Detall', label: 'Màxim' },
];

const gallery = [
  { src: '/images/services/final-obra/gallery-1.webp', alt: 'Aspirat industrial i retirada de guix després d\'obra', caption: 'Aspirat industrial de pols i residus d\'obra' },
  { src: '/images/services/final-obra/gallery-2.webp', alt: 'Habitatge reformat net llest per entrar a viure', caption: 'Habitatge net després de reforma integral' },
  { src: '/images/services/final-obra/gallery-3.webp', alt: 'Acabats i terres impecables després de final d\'obra', caption: 'Terres i fusteria sense restes de ciment' },
  { src: '/images/services/final-obra/gallery-4.webp', alt: 'Cuina desinfectada i llesta per al lliurament', caption: 'Cuines i banys llestos per al lliurament' },
];

const zones = ['Tarragona', 'Reus', 'Salou', 'Cambrils', 'Vila-seca', 'Constantí'];
---

<BaseLayout
  title="Neteja final d'obra a Tarragona | NaturLimp"
  description="Servei de neteja de fi d'obra a Tarragona per a pisos, cases i locals. Eliminem pols i restes de construcció per deixar-ho llest per entrar-hi a viure."
  lang="ca"
  canonical="https://naturlimp.com/ca/serveis/neteja-final-obra-tarragona/"
>
  <Header lang="ca" t={flat} />
  
  <main id="main-content">
    <ServiceLayout
      lang="ca"
      t={t}
      serviceNum="08"
      serviceTag="Puntual"
      heroImage="/images/services/final-obra/hero.webp"
      breadcrumb="Neteja final d'obra"
      headline="Neteja a fons de final d'obra"
      subheadline="Deixem la seva llar o local a punt per estrenar. Ens encarreguem de la pols i els residus més difícils amb la màxima celeritat."
      checklist={checklist}
      stats={stats}
      gallery={gallery}
      zones={zones}
      zonesText="Ideal per a reformes integrals o obra nova. Treballem per a particulars i constructores a tota la província de Tarragona."
    />
  </main>

  <Footer lang="ca" t={flat} />
</BaseLayout>
