---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ServiceLayout from '../../../components/ServiceLayout.astro';
import { flattenI18n } from '../../../utils/i18n';

const rawT = await import('../../../i18n/ca.json');
const t = rawT.default;
const flat = flattenI18n(t as unknown as Record<string, unknown>);

const checklist = [
  'Neteja de mobiliari, escriptoris i cadires',
  'Desinfecció de punts de contacte (poms, interruptors)',
  'Neteja d\'equips informàtics i pantalles',
  'Higienització completa de banys i zones de cafè',
  'Buidat de papereres i reciclatge',
  'Aspirat i fregat de terres segons material',
  'Manteniment de vidres interiors i mampares',
];

const stats = [
  { value: 'Fix', label: 'Equip' },
  { value: 'Pro', label: 'Productes' },
  { value: '100%', label: 'Discreció' },
];

const gallery = [
  { src: 'https://picsum.photos/seed/nl-ca-office1/800/600', alt: 'Neteja d\'oficines', caption: 'Entorns de treball sans' },
  { src: 'https://picsum.photos/seed/nl-ca-office2/800/600', alt: 'Despatxos nets', caption: 'Productivitat i higiene' },
];

const zones = ['Tarragona', 'Reus', 'Vila-seca', 'Constantí', 'La Canonja'];
---

<BaseLayout
  title="Neteja d'oficines i locals a Tarragona | NaturLimp"
  description="Servei professional de neteja d'oficines, despatxos i locals comercials a Tarragona i Reus. Flexibilitat horària i resultats garantits."
  lang="ca"
>
  <Header lang="ca" t={flat} />
  
  <main id="main-content">
    <ServiceLayout
      lang="ca"
      t={t}
      serviceNum="06"
      serviceTag="Corporatiu"
      breadcrumb="Oficines i locals"
      headline="Neteja d'oficines i centres de treball"
      subheadline="Mantenim el seu espai de treball net i saludable, millorant el benestar del seu equip i la imatge davant els seus clients."
      checklist={checklist}
      stats={stats}
      gallery={gallery}
      zones={zones}
      zonesText="Ens adaptem als seus horaris (matins, tardes o nits) per no interferir en la seva activitat laboral. Servei a tota la zona industrial i urbana."
    />
  </main>

  <Footer lang="ca" t={flat} />
</BaseLayout>
