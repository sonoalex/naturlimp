---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ServiceLayout from '../../../components/ServiceLayout.astro';
import { flattenI18n } from '../../../utils/i18n';

const rawT = await import('../../../i18n/ca.json');
const t = rawT.default;
const flat = flattenI18n(t as unknown as Record<string, unknown>);

const checklist = [
  'Neteja i fregat de portals, hall i rebedor',
  'Escombrat i fregat d\'escales i replans',
  'Neteja d\'ascensors: terra, parets i miralls',
  'Neteja de garatges i trasters comuns',
  'Neteja de vidres i finestres de zones comunes',
  'Buidat de papereres i gestió de residus',
  'Zones exteriors: patis, jardins i accessos',
  'Informe mensual dels treballs realitzats',
];

const stats = [
  { value: '150+', label: 'Comunitats' },
  { value: '24h', label: 'Resposta' },
  { value: 'RC', label: 'Assegurança' },
];

const gallery = [
  { src: 'https://picsum.photos/seed/nl-ca-comm1/800/600', alt: 'Neteja de portal a Tarragona', caption: 'Portals impecables' },
  { src: 'https://picsum.photos/seed/nl-ca-comm2/800/600', alt: 'Escales netes', caption: 'Escales i replans' },
  { src: 'https://picsum.photos/seed/nl-ca-comm3/800/600', alt: 'Neteja de vidres comunitaris', caption: 'Vidres brillants' },
  { src: 'https://picsum.photos/seed/nl-ca-comm4/800/600', alt: 'Garatge net', caption: 'Manteniment de garatges' },
];

const zones = ['Tarragona', 'Reus', 'Salou', 'Cambrils', 'Vila-seca', 'Torredembarra', 'Constantí', 'La Canonja', 'Altafulla'];
---

<BaseLayout
  title="Neteja de comunitats de veïns a Tarragona | NaturLimp"
  description="Servei professional de neteja de comunitats a Tarragona, Reus, Salou i Cambrils. Portals, escales, garatges i zones comunes. Pressupost sense compromís."
  lang="ca"
>
  <Header lang="ca" t={flat} />
  
  <main id="main-content">
    <ServiceLayout
      lang="ca"
      t={t}
      serviceNum="01"
      serviceTag="Manteniment"
      breadcrumb="Neteja de comunitats"
      headline="Neteja professional de comunitats de veïns"
      subheadline="Ens encarreguem de mantenir el seu edifici impecable, des del portal fins al terrat, amb la màxima confiança i resultats garantits."
      checklist={checklist}
      stats={stats}
      gallery={gallery}
      zones={zones}
      zonesText="Donem cobertura a tota la ciutat de Tarragona i municipis colindants. Ens adaptem a les necessitats de cada escala, des de petits edificis fins a grans complexos residencials."
    />
  </main>

  <Footer lang="ca" t={flat} />
</BaseLayout>
