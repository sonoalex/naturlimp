---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ContactForm from '../../../components/ContactForm';
import ServiceAreaMap from '../../../components/ServiceAreaMap.astro';
import { flattenI18n } from '../../../utils/i18n';

const rawT = await import('../../../i18n/ca.json');
const t = rawT.default;
const flat = flattenI18n(t as unknown as Record<string, unknown>);
---

<BaseLayout
  title="Contacte i Pressupost de Neteja — NaturLimp Tarragona"
  description="Contacta amb Natur Limp Tarragona SLU. Sol·licita el teu pressupost gratuït per a comunitats de veïns, oficines, final d'obra o piscines. Telèfon 603 765 253 i WhatsApp."
  lang="ca"
  canonical="https://naturlimp.com/ca/contacte/"
>
  <Header lang="ca" t={flat} />

  <main id="main-content">

    <!-- ── Hero & Contact Section ──────────────────────────────────────────────── -->
    <section class="relative bg-[var(--color-foreground)] text-white pt-32 pb-24 overflow-hidden">
      <div
        class="pointer-events-none absolute inset-0"
        style="background: radial-gradient(ellipse 65% 60% at 50% 20%, rgba(162,217,97,0.18) 0%, transparent 70%);"
        aria-hidden="true"
      />

      <div class="relative mx-auto max-w-7xl px-6 sm:px-10 lg:px-14">
        <!-- Breadcrumb -->
        <nav class="mb-6 flex items-center gap-2 text-xs text-white/50" aria-label="Ruta de navegació">
          <a href="/ca" class="hover:text-white transition-colors">Inici</a>
          <span>/</span>
          <span class="text-[var(--color-primary)] font-medium">Contacte</span>
        </nav>

        <div class="grid grid-cols-1 gap-14 lg:grid-cols-12 lg:gap-16 items-start">

          <!-- Left column -->
          <div class="lg:col-span-5 flex flex-col justify-center">
            <div class="mb-4 inline-flex items-center gap-2 rounded-sm border border-[var(--color-primary)]/40 bg-[var(--color-primary)]/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--color-primary-light)] w-fit">
              <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-primary)]" aria-hidden="true"></span>
              Atenció directa i pressupostos
            </div>

            <h1 class="font-display text-4xl sm:text-5xl font-bold tracking-tight text-white leading-tight">
              Parlem del teu projecte de neteja?
            </h1>
            <p class="mt-5 text-base sm:text-lg text-white/60 leading-relaxed">
              Demana el teu pressupost a mida sense cap compromís. Et responem en menys de 24 hores i ens desplacem per valorar la teva comunitat o instal·lació si cal.
            </p>

            <div class="mt-8 space-y-3.5">
              <!-- Telèfon -->
              <a
                href="tel:+34603765253"
                class="group flex items-center gap-4 rounded-xl border border-white/8 bg-white/[0.02] p-4 transition-all duration-200 hover:border-[var(--color-primary)]/40 hover:bg-white/[0.05]"
              >
                <span class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-[var(--color-primary)]/20 text-[var(--color-primary-light)] transition-colors group-hover:bg-[var(--color-primary)]/30">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.99 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.9 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
                  </svg>
                </span>
                <div>
                  <span class="block text-[11px] uppercase tracking-widest text-white/40 font-semibold">Truca'ns</span>
                  <span class="block text-base font-bold text-white">603 765 253</span>
                </div>
              </a>

              <!-- WhatsApp -->
              <a
                href="https://wa.me/34603765253?text=Hola%2C%20m%27agradaria%20demanar%20un%20pressupost"
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-4 rounded-xl border border-white/8 bg-white/[0.02] p-4 transition-all duration-200 hover:border-[var(--color-primary)]/40 hover:bg-white/[0.05]"
              >
                <span class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-[var(--color-primary)]/20 text-[var(--color-primary-light)] transition-colors group-hover:bg-[var(--color-primary)]/30">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
                  </svg>
                </span>
                <div>
                  <span class="block text-[11px] uppercase tracking-widest text-white/40 font-semibold">WhatsApp Immediat</span>
                  <span class="block text-base font-bold text-white">603 765 253</span>
                </div>
              </a>

              <!-- Email -->
              <a
                href="mailto:contacto@naturlimp.com"
                class="group flex items-center gap-4 rounded-xl border border-white/8 bg-white/[0.02] p-4 transition-all duration-200 hover:border-[var(--color-primary)]/40 hover:bg-white/[0.05]"
              >
                <span class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-[var(--color-primary)]/20 text-[var(--color-primary-light)] transition-colors group-hover:bg-[var(--color-primary)]/30">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                  </svg>
                </span>
                <div>
                  <span class="block text-[11px] uppercase tracking-widest text-white/40 font-semibold">Correu Electrònic</span>
                  <span class="block text-base font-bold text-white">contacto@naturlimp.com</span>
                </div>
              </a>

              <!-- Horari -->
              <div class="flex items-center gap-4 rounded-xl border border-white/8 bg-white/[0.02] p-4">
                <span class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-white/5 text-white/60">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                  </svg>
                </span>
                <div>
                  <span class="block text-[11px] uppercase tracking-widest text-white/40 font-semibold">Horari d'Atenció</span>
                  <span class="block text-xs sm:text-sm font-medium text-white/90">Dilluns a Divendres: 8:00 - 18:00</span>
                  <span class="block text-xs text-white/40">Tardes amb cita prèvia</span>
                </div>
              </div>
            </div>

            <div class="mt-8 border-t border-white/8 pt-6 grid grid-cols-2 gap-4 text-xs text-white/70">
              <div class="flex items-center gap-2">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-[var(--color-primary)] shrink-0"><path d="M20 6L9 17l-5-5"/></svg>
                <span>Assegurança RC integral</span>
              </div>
              <div class="flex items-center gap-2">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-[var(--color-primary)] shrink-0"><path d="M20 6L9 17l-5-5"/></svg>
                <span>Equip amb contracte</span>
              </div>
              <div class="flex items-center gap-2">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-[var(--color-primary)] shrink-0"><path d="M20 6L9 17l-5-5"/></svg>
                <span>Sense permanència</span>
              </div>
              <div class="flex items-center gap-2">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-[var(--color-primary)] shrink-0"><path d="M20 6L9 17l-5-5"/></svg>
                <span>Resposta en 24h</span>
              </div>
            </div>
          </div>

          <!-- Right column -->
          <div class="lg:col-span-7">
            <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-8 backdrop-blur-md sm:p-10 shadow-2xl">
              <h2 class="font-display text-2xl sm:text-3xl font-bold text-white mb-2">
                Sol·licita pressupost sense compromís
              </h2>
              <p class="text-sm text-white/50 mb-8">
                Explica'ns què necessites i et facilitarem una proposta ajustada a les teves necessitats i freqüència requerida.
              </p>
              <ContactForm client:load t={t.contact} />
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ── Service Area Map ───────────────────────────────────────────────────── -->
    <ServiceAreaMap />

  </main>

  <Footer lang="ca" t={flat} />
</BaseLayout>
