---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LocalSeoLayout from '../../components/LocalSeoLayout.astro';
import { flattenI18n } from '../../utils/i18n';

const rawT = await import('../../i18n/es.json');
const t = rawT.default;
const flat = flattenI18n(t as unknown as Record<string, unknown>);
---

<BaseLayout
  title="Limpieza profesional en Cambrils | NaturLimp · Costa Daurada"
  description="Servicio de limpieza en Cambrils: comunidades, piscinas, final de obra y oficinas. Empresa de Tarragona a 18 km con equipo propio. Presupuesto gratuito sin compromiso."
  lang="es"
  canonical="https://naturlimp.com/es/limpieza-profesional-cambrils"
>
  <Header lang="es" t={flat} />
  <main id="main-content">
    <LocalSeoLayout
      city="Cambrils"
      citySlug="cambrils"
      distanceKm={18}
      province="Tarragona"
      t={t}
      lang="es"
    />
  </main>
  <Footer lang="es" t={flat} />
</BaseLayout>
