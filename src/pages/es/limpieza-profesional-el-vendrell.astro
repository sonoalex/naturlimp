---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LocalSeoLayout from '../../components/LocalSeoLayout.astro';
import { flattenI18n } from '../../utils/i18n';

const rawT = await import('../../i18n/es.json');
const t = rawT.default;
const flat = flattenI18n(t as unknown as Record<string, unknown>);
---

<BaseLayout
  title="Limpieza profesional en El Vendrell | NaturLimp · Baix Penedès"
  description="Servicio de limpieza en El Vendrell (Baix Penedès): comunidades, final de obra, cristales y oficinas. Empresa de Tarragona que cubre El Vendrell a 30 km. Presupuesto gratis."
  lang="es"
  canonical="https://naturlimp.com/es/limpieza-profesional-el-vendrell"
>
  <Header lang="es" t={flat} />
  <main id="main-content">
    <LocalSeoLayout
      city="El Vendrell"
      citySlug="el-vendrell"
      distanceKm={30}
      province="Tarragona"
      t={t}
      lang="es"
    />
  </main>
  <Footer lang="es" t={flat} />
</BaseLayout>
