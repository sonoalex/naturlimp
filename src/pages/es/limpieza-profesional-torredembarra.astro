---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LocalSeoLayout from '../../components/LocalSeoLayout.astro';
import { flattenI18n } from '../../utils/i18n';

const rawT = await import('../../i18n/es.json');
const t = rawT.default;
const flat = flattenI18n(t as unknown as Record<string, unknown>);
---

<BaseLayout
  title="Limpieza profesional en Torredembarra | NaturLimp"
  description="Servicio de limpieza en Torredembarra: comunidades, piscinas, cristales y final de obra. Empresa local de Tarragona a 14 km. Equipo propio, seguro RC. Presupuesto gratis."
  lang="es"
  canonical="https://naturlimp.com/es/limpieza-profesional-torredembarra"
>
  <Header lang="es" t={flat} />
  <main id="main-content">
    <LocalSeoLayout
      city="Torredembarra"
      citySlug="torredembarra"
      distanceKm={14}
      province="Tarragona"
      t={t}
      lang="es"
    />
  </main>
  <Footer lang="es" t={flat} />
</BaseLayout>
