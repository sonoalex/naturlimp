---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ServiceLayout from '../../../components/ServiceLayout.astro';
import { flattenI18n } from '../../../utils/i18n';

const rawT = await import('../../../i18n/es.json');
const t = rawT.default;
const flat = flattenI18n(t as unknown as Record<string, unknown>);
---

<BaseLayout
  title="Limpieza de parkings y garajes en Tarragona | NaturLimp"
  description="Servicio profesional de limpieza de parkings comunitarios y comerciales en Tarragona, Reus y comarca. Fregadoras industriales y desengrasado profundo. Presupuesto gratis."
  lang="es"
  canonical="https://naturlimp.com/es/servicios/limpieza-parkings-tarragona/"
>
  <Header lang="es" t={flat} />
  <main id="main-content">
    <ServiceLayout
      lang="es"
      t={t}
      heroImage="/images/services/parkings/hero.webp"
      serviceNum="04"
      serviceTag="Garajes · Hidrolimpieza · Desengrasado"
      breadcrumb="Limpieza de parkings"
      headline="Limpieza de parkings y garajes en Tarragona y comarca"
      subheadline="Mantenimiento preventivo y limpieza profunda de parkings comunitarios, públicos y privados con barredoras y fregadoras industriales con aspiración de agua."
      stats={[
        { value: '15', label: 'años de experiencia' },
        { value: '120+', label: 'parkings tratados' },
        { value: '30 km', label: 'radio de servicio' },
        { value: '24 h', label: 'tiempo de respuesta' },
      ]}
      checklist={[
        'Barrido mecánico y aspirado exhaustivo de polvo, hojas y rodaduras',
        'Fregado mecanizado con máquinas fregadoras de conductor sentado',
        'Tratamiento específico con desengrasantes ecológicos en manchas de aceite y carburante',
        'Limpieza de rampas de acceso, viales y zonas de maniobra',
        'Limpieza de tuberías vistas, bajantes, extintores y cajas de luz',
        'Desempolvado y limpieza de luminarias y pilotos de emergencia',
        'Limpieza y desinfección de puertas automáticas y botoneras de acceso',
        'Vaciado de papeleras y limpieza de sumideros y arquetas perimetrales',
      ]}
      gallery={[
        { src: '/images/services/parkings/gallery-1.webp', alt: 'Fregadora industrial de conductor sentado para parkings', caption: 'Fregado mecánico con conductor sentado' },
        { src: '/images/services/parkings/gallery-2.webp', alt: 'Garaje subterráneo limpio en Tarragona', caption: 'Garaje comunitario impecable' },
        { src: '/images/services/parkings/gallery-3.webp', alt: 'Suelo de parking con pintura epoxi y señalización', caption: 'Pavimento epoxi y líneas delimitadoras' },
        { src: '/images/services/parkings/gallery-4.webp', alt: 'Rampas y accesos de garaje limpios', caption: 'Rampas y accesos peatonales' },
      ]}
      zonesText="Limpieza de parkings y garajes en Tarragona capital (Eixample, Part Alta, Serrallo, Ponent), Reus, Salou, Cambrils, Vila-seca, Torredembarra, Altafulla y polígonos industriales de toda la comarca."
      zones={['Tarragona', 'Reus', 'Salou', 'Cambrils', 'Vila-seca', 'Torredembarra', 'Constantí', 'La Canonja', 'Valls']}
    />
  </main>
  <Footer lang="es" t={flat} />
</BaseLayout>
