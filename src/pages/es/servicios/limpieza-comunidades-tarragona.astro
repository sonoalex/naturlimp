---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ServiceLayout from '../../../components/ServiceLayout.astro';
import { flattenI18n } from '../../../utils/i18n';

const rawT = await import('../../../i18n/es.json');
const t = rawT.default;
const flat = flattenI18n(t as unknown as Record<string, unknown>);
---

<BaseLayout
  title="Limpieza de comunidades de vecinos en Tarragona | NaturLimp"
  description="Servicio profesional de limpieza de comunidades en Tarragona, Reus, Salou y Cambrils. Portales, escaleras, garajes y zonas comunes. Presupuesto sin compromiso."
  lang="es"
  canonical="https://naturlimp.com/es/servicios/limpieza-comunidades-tarragona"
>
  <Header lang="es" t={flat} />
  <main id="main-content">
    <ServiceLayout
      lang="es"
      t={t}
      serviceNum="01"
      serviceTag="Comunidades · Portales · Zonas comunes"
      breadcrumb="Limpieza de comunidades"
      headline="Limpieza de comunidades en Tarragona y comarca"
      subheadline="Portales, escaleras, garajes y zonas comunes con equipo propio, seguro de responsabilidad civil y contrato a medida para cada comunidad."
      stats={[
        { value: '15', label: 'años de experiencia' },
        { value: '150+', label: 'comunidades activas' },
        { value: '30 km', label: 'radio de servicio' },
        { value: '24 h', label: 'tiempo de respuesta' },
      ]}
      checklist={[
        'Limpieza y fregado de portales, hall y recibidor',
        'Barrido y fregado de escaleras y rellanos',
        'Limpieza de ascensores: suelo, paredes y espejos',
        'Limpieza de garajes y trasteros comunes',
        'Limpieza de cristales y ventanas de zonas comunes',
        'Vaciado de papeleras y gestión de residuos',
        'Zonas exteriores: patios, jardines y accesos',
        'Informe mensual de trabajos realizados',
      ]}
      gallery={[
        { src: 'https://picsum.photos/seed/nl-com-1/600/820', alt: 'Portal de comunidad de vecinos limpio en Tarragona', caption: 'Portal impecable tras el servicio' },
        { src: 'https://picsum.photos/seed/nl-com-2/500/400', alt: 'Escaleras y rellanos de comunidad limpios', caption: 'Escaleras y rellanos' },
        { src: 'https://picsum.photos/seed/nl-com-3/500/400', alt: 'Zonas comunes de edificio residencial limpias', caption: 'Zonas comunes' },
        { src: 'https://picsum.photos/seed/nl-com-4/900/520', alt: 'Garaje y accesos de comunidad limpios en Tarragona', caption: 'Garaje y accesos' },
      ]}
      zonesText="Prestamos servicio de limpieza de comunidades en Tarragona (Serrallo, Part Alta, Eixample, Campclar, Bonavista), Reus, Salou, Cambrils, Vila-seca, Torredembarra, Constantí y todos los municipios en un radio de 30 km."
      zones={['Tarragona', 'Reus', 'Salou', 'Cambrils', 'Vila-seca', 'Torredembarra', 'Constantí', 'El Vendrell', 'La Canonja', 'Altafulla']}
    />
  </main>
  <Footer lang="es" t={flat} />
</BaseLayout>
