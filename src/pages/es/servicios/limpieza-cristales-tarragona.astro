---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ServiceLayout from '../../../components/ServiceLayout.astro';
import { flattenI18n } from '../../../utils/i18n';

const rawT = await import('../../../i18n/es.json');
const t = rawT.default;
const flat = flattenI18n(t as unknown as Record<string, unknown>);
---

<BaseLayout
  title="Limpieza de cristales y fachadas en Tarragona | NaturLimp"
  description="Limpieza profesional de cristales, escaparates y fachadas acristaladas en Tarragona, Reus y comarca. Técnicas en altura, sin andamios. Presupuesto sin compromiso."
  lang="es"
  canonical="https://naturlimp.com/es/servicios/limpieza-cristales-tarragona/"
>
  <Header lang="es" t={flat} />
  <main id="main-content">
    <ServiceLayout
      lang="es"
      t={t}
      heroImage="/images/services/cristales/hero.webp"
      serviceNum="12"
      serviceTag="Cristales · Fachadas · Escaparates"
      breadcrumb="Limpieza de cristales"
      headline="Limpieza de cristales y fachadas en Tarragona"
      subheadline="Cristales, escaparates y fachadas acristaladas impecables. Técnicas en altura sin andamios para edificios residenciales, locales y comunidades de toda la comarca."
      stats={[
        { value: 'Sin andamios', label: 'trabajos en altura' },
        { value: '15', label: 'años de experiencia' },
        { value: '30 km', label: 'radio de servicio' },
        { value: '24 h', label: 'tiempo de respuesta' },
      ]}
      checklist={[
        'Limpieza de escaparates y ventanas de locales y viviendas',
        'Fachadas acristaladas y cortinas de cristal',
        'Cristales en altura con técnicas de trabajo vertical sin andamios',
        'Limpieza de marcos, perfiles y premarcos',
        'Eliminación de cal, grasa y manchas persistentes',
        'Limpieza de barandillas y antepechos de cristal',
        'Tratamiento hidrofóbico opcional para mayor durabilidad',
        'Servicio periódico: semanal, quincenal o mensual',
      ]}
      gallery={[
        { src: '/images/services/cristales/gallery-1.webp', alt: 'Portal acristalado y espejos relucientes en Tarragona', caption: 'Cristales de portal y espejos sin huellas' },
        { src: '/images/services/cristales/gallery-2.webp', alt: 'Limpieza de cristales en local comercial', caption: 'Escaparates y ventanales de comercio' },
        { src: '/images/services/cristales/gallery-3.webp', alt: 'Mamparas divisorias y cristaleras de oficina', caption: 'Mamparas de oficina con acabado transparente' },
        { src: '/images/services/cristales/gallery-4.webp', alt: 'Fachada acristalada limpia', caption: 'Limpieza técnica de cristaleras en altura' },
      ]}
      zonesText="Realizamos limpieza de cristales en Tarragona (Eixample, Part Alta, Serrallo, Campclar, Bonavista), Reus, Salou, Cambrils, Vila-seca, Torredembarra, El Vendrell y toda la comarca. Servicio para comunidades de vecinos, locales comerciales, hoteles y edificios de oficinas."
      zones={['Tarragona', 'Reus', 'Salou', 'Cambrils', 'Vila-seca', 'Torredembarra', 'El Vendrell', 'Altafulla', 'Constantí']}
    />
  </main>
  <Footer lang="es" t={flat} />
</BaseLayout>
