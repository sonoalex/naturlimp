---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ServiceLayout from '../../../components/ServiceLayout.astro';
import { flattenI18n } from '../../../utils/i18n';

const rawT = await import('../../../i18n/es.json');
const t = rawT.default;
const flat = flattenI18n(t as unknown as Record<string, unknown>);
---

<BaseLayout
  title="Limpieza de final de obra en Tarragona | NaturLimp"
  description="Limpieza profesional de final de obra en Tarragona, Reus y Costa Daurada. Retiramos polvo, restos de pintura y residuos en viviendas, locales y comunidades. Presupuesto sin compromiso."
  lang="es"
  canonical="https://naturlimp.com/es/servicios/limpieza-final-obra-tarragona/"
>
  <Header lang="es" t={flat} />
  <main id="main-content">
    <ServiceLayout
      lang="es"
      t={t}
      heroImage="/images/services/final-obra/hero.webp"
      serviceNum="08"
      serviceTag="Final de obra · Reformas · Rehabilitación"
      breadcrumb="Limpieza de final de obra"
      headline="Limpieza de final de obra en Tarragona y Costa Daurada"
      subheadline="Limpieza exhaustiva tras reformas, obra nueva y rehabilitaciones. Polvo, restos de pintura, escayola y residuos eliminados antes de la entrega o la mudanza."
      stats={[
        { value: '17', label: 'años de experiencia' },
        { value: '200+', label: 'obras completadas' },
        { value: '30 km', label: 'radio de servicio' },
        { value: '48 h', label: 'disponibilidad' },
      ]}
      checklist={[
        'Retirada de polvo de obra en techos, paredes y superficies',
        'Limpieza de ventanas, marcos, persianas y premarcos',
        'Eliminación de restos de pintura, escayola, mortero y adhesivos',
        'Limpieza a fondo de cocina, baños y zonas húmedas',
        'Aspirado y fregado de suelos y baldosas',
        'Limpieza interior de armarios empotrados, carpinterías y herrajes',
        'Recogida y gestión de residuos de obra',
        'Abrillantado o cristalizado de suelos si se solicita',
      ]}
      gallery={[
        { src: '/images/services/final-obra/gallery-1.webp', alt: 'Aspirado industrial y retirada de yeso tras obra', caption: 'Aspirado industrial de polvo y residuos de obra' },
        { src: '/images/services/final-obra/gallery-2.webp', alt: 'Vivienda reformada limpia lista para entrar a vivir', caption: 'Vivienda limpia tras reforma integral' },
        { src: '/images/services/final-obra/gallery-3.webp', alt: 'Acabados y suelos impecables tras fin de obra', caption: 'Suelos y carpintería sin restos de cemento' },
        { src: '/images/services/final-obra/gallery-4.webp', alt: 'Cocina desinfectada y lista para entrega', caption: 'Cocinas y baños listos para entrega' },
      ]}
      zonesText="Realizamos limpiezas de final de obra en Tarragona (Part Alta, Eixample, Serrallo, Campclar), Reus, Salou, Cambrils, Vila-seca, Torredembarra, El Vendrell y todos los municipios en un radio de 30 km. Viviendas, locales comerciales, comunidades y naves industriales."
      zones={['Tarragona', 'Reus', 'Salou', 'Cambrils', 'Vila-seca', 'Torredembarra', 'El Vendrell', 'Valls', 'Constantí', 'La Canonja']}
    />
  </main>
  <Footer lang="es" t={flat} />
</BaseLayout>
