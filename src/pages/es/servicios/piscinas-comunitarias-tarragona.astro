---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ServiceLayout from '../../../components/ServiceLayout.astro';
import { flattenI18n } from '../../../utils/i18n';

const rawT = await import('../../../i18n/es.json');
const t = rawT.default;
const flat = flattenI18n(t as unknown as Record<string, unknown>);
---

<BaseLayout
  title="Limpieza y mantenimiento de piscinas comunitarias en Tarragona | NaturLimp"
  description="Servicio profesional de limpieza y mantenimiento de piscinas comunitarias en Tarragona, Salou, Cambrils y Vila-seca. Tratamiento del agua, limpieza de vasos y filtros. Presupuesto sin compromiso."
  lang="es"
  canonical="https://naturlimp.com/es/servicios/piscinas-comunitarias-tarragona/"
>
  <Header lang="es" t={flat} />
  <main id="main-content">
    <ServiceLayout
      lang="es"
      t={t}
      heroImage="/images/services/piscinas/hero.webp"
      serviceNum="03"
      serviceTag="Piscinas · Aguas · Temporada completa"
      breadcrumb="Piscinas comunitarias"
      headline="Piscinas comunitarias en Tarragona y la Costa Daurada"
      subheadline="Limpieza, desinfección y mantenimiento de piscinas de comunidades de abril a octubre. Equipo especializado con formación en tratamiento de aguas."
      stats={[
        { value: '50+', label: 'piscinas en servicio' },
        { value: 'Abr–Oct', label: 'temporada completa' },
        { value: '30 km', label: 'radio de servicio' },
        { value: '24 h', label: 'tiempo de respuesta' },
      ]}
      checklist={[
        'Análisis y corrección de los parámetros del agua: cloro, pH y alcalinidad',
        'Limpieza del vaso: cepillado de paredes y suelo',
        'Aspirado de fondos y recogida de hojas y residuos flotantes',
        'Limpieza y revisión de filtros, bombas y skimmers',
        'Tratamiento con productos homologados y aptos para uso comunitario',
        'Limpieza de bordillos, escaleras y playa de la piscina',
        'Control de algas y tratamiento preventivo',
        'Informe del estado del agua en cada visita',
      ]}
      gallery={[
        { src: '/images/services/piscinas/gallery-1.webp', alt: 'Mantenimiento de piscina por personal de NaturLimp', caption: 'Aspirado de fondo, limpieza de skimmers y depuradora' },
        { src: '/images/services/piscinas/gallery-2.webp', alt: 'Piscina comunitaria con agua cristalina en Tarragona', caption: 'Puesta a punto y mantenimiento estival' },
        { src: '/images/services/piscinas/gallery-3.webp', alt: 'Control químico y desinfección del agua', caption: 'Equilibrio de pH, cloración y filtros' },
        { src: '/images/services/piscinas/gallery-4.webp', alt: 'Entorno de piscina comunitaria limpio', caption: 'Cuidado de coronación y accesos' },
      ]}
      zonesText="Realizamos mantenimiento de piscinas comunitarias en Salou, Cambrils, Vila-seca, Miami Platja, Torredembarra, Altafulla y toda la Costa Daurada. También en Tarragona y Reus. Servicio disponible de abril a octubre, con apertura y cierre de temporada incluidos."
      zones={['Salou', 'Cambrils', 'Vila-seca', 'Tarragona', 'Reus', 'Torredembarra', 'Altafulla', 'Miami Platja', 'Creixell', 'Calafell']}
    />
  </main>
  <Footer lang="es" t={flat} />
</BaseLayout>
