---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ServiceLayout from '../../../components/ServiceLayout.astro';
import { flattenI18n } from '../../../utils/i18n';

const rawT = await import('../../../i18n/es.json');
const t = rawT.default;
const flat = flattenI18n(t as unknown as Record<string, unknown>);
---

<BaseLayout
  title="Abrillantado y pulido de suelos en Tarragona | NaturLimp"
  description="Pulido, cristalizado y abrillantado profesional de mármol, terrazo y porcelánico en Tarragona, Reus y comarca. Resultados visibles desde la primera sesión. Presupuesto sin compromiso."
  lang="es"
  canonical="https://naturlimp.com/es/servicios/abrillantado-suelos-tarragona"
>
  <Header lang="es" t={flat} />
  <main id="main-content">
    <ServiceLayout
      lang="es"
      t={t}
      serviceNum="04"
      serviceTag="Terrazo · Mármol · Porcelánico"
      breadcrumb="Abrillantado de suelos"
      headline="Abrillantado y pulido de suelos en Tarragona"
      subheadline="Recuperamos el brillo original de mármol, terrazo y porcelánico en viviendas, comunidades y locales. Maquinaria profesional, resultados desde la primera sesión."
      stats={[
        { value: '15', label: 'años de experiencia' },
        { value: '1ª sesión', label: 'resultado visible' },
        { value: '30 km', label: 'radio de servicio' },
        { value: '24 h', label: 'tiempo de respuesta' },
      ]}
      checklist={[
        'Limpieza previa profunda de suelos y juntas',
        'Decapado y eliminación de capas antiguas de cera o suciedad incrustada',
        'Pulido con maquinaria profesional (terrazo, mármol y porcelánico)',
        'Cristalizado de suelos de mármol y terrazo',
        'Abrillantado final con productos de alta durabilidad',
        'Sellado de poros y tratamiento antihumedad',
        'Aplicación de cera de mantenimiento si se solicita',
        'Servicio de mantenimiento periódico para prolongar el resultado',
      ]}
      gallery={[
        { src: 'https://picsum.photos/seed/nl-suelo-1/600/820', alt: 'Suelo de terrazo abrillantado en Tarragona', caption: 'Terrazo recuperado como nuevo' },
        { src: 'https://picsum.photos/seed/nl-suelo-2/500/400', alt: 'Mármol pulido y brillante en portal de comunidad', caption: 'Mármol pulido en portal' },
        { src: 'https://picsum.photos/seed/nl-suelo-3/500/400', alt: 'Proceso de pulido profesional de suelos', caption: 'Proceso de pulido profesional' },
        { src: 'https://picsum.photos/seed/nl-suelo-4/900/520', alt: 'Resultado final de abrillantado de suelo en local', caption: 'Resultado final en local comercial' },
      ]}
      zonesText="Realizamos abrillantado y pulido de suelos en Tarragona (Part Alta, Serrallo, Eixample, Bonavista), Reus, Salou, Cambrils, Vila-seca, Torredembarra y toda la comarca. Servicio para viviendas, portales de comunidades, hoteles, restaurantes y locales comerciales."
      zones={['Tarragona', 'Reus', 'Salou', 'Cambrils', 'Vila-seca', 'Torredembarra', 'Constantí', 'Altafulla', 'Valls']}
    />
  </main>
  <Footer lang="es" t={flat} />
</BaseLayout>
