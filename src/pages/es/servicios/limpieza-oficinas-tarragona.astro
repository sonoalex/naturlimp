---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ServiceLayout from '../../../components/ServiceLayout.astro';
import { flattenI18n } from '../../../utils/i18n';

const rawT = await import('../../../i18n/es.json');
const t = rawT.default;
const flat = flattenI18n(t as unknown as Record<string, unknown>);
---

<BaseLayout
  title="Limpieza de oficinas y locales comerciales en Tarragona | NaturLimp"
  description="Servicio de limpieza profesional para oficinas, locales y espacios comerciales en Tarragona y comarca. Mantenimiento diario o periódico, horarios adaptados. Presupuesto sin compromiso."
  lang="es"
  canonical="https://naturlimp.com/es/servicios/limpieza-oficinas-tarragona/"
>
  <Header lang="es" t={flat} />
  <main id="main-content">
    <ServiceLayout
      lang="es"
      t={t}
      heroImage="/images/services/oficinas/hero.webp"
      serviceNum="09"
      serviceTag="Oficinas · Locales · Comercios"
      breadcrumb="Oficinas y locales"
      headline="Limpieza de oficinas y locales en Tarragona"
      subheadline="Mantenimiento diario o periódico adaptado a tu horario de actividad. Antes de abrir, después de cerrar o en fin de semana. Equipo propio con seguro de responsabilidad civil."
      stats={[
        { value: '17', label: 'años de experiencia' },
        { value: 'Horario', label: 'adaptado a ti' },
        { value: '30 km', label: 'radio de servicio' },
        { value: '24 h', label: 'tiempo de respuesta' },
      ]}
      checklist={[
        'Limpieza diaria o periódica de zonas de trabajo y despachos',
        'Aspirado y fregado de suelos, moquetas y alfombras',
        'Limpieza de escritorios, equipos y mobiliario de oficina',
        'Desinfección de zonas comunes: cocinas, baños y salas de reuniones',
        'Vaciado de papeleras y gestión de residuos',
        'Limpieza de ventanas y cristales interiores',
        'Mantenimiento de fachadas, accesos y zonas de paso',
        'Horarios adaptados: antes de abrir, tras el cierre o en fin de semana',
      ]}
      gallery={[
        { src: '/images/services/oficinas/gallery-1.webp', alt: 'Equipo NaturLimp limpiando local comercial en Tarragona', caption: 'Personal de NaturLimp en local comercial' },
        { src: '/images/services/oficinas/gallery-2.webp', alt: 'Limpieza y desinfección de mostrador y áreas comerciales', caption: 'Desinfección de mostradores y zonas de atención' },
        { src: '/images/services/oficinas/gallery-3.webp', alt: 'Despacho y oficinas limpias en Tarragona', caption: 'Puestos de trabajo y despachos limpios' },
        { src: '/images/services/oficinas/gallery-4.webp', alt: 'Zona corporativa higienizada', caption: 'Mantenimiento integral de oficinas' },
      ]}
      zonesText="Prestamos servicio de limpieza de oficinas y locales en Tarragona (polígono Francolí, Eixample, Part Alta, Serrallo), Reus, Salou, Cambrils, Vila-seca, La Canonja, Constantí y todos los municipios en un radio de 30 km."
      zones={['Tarragona', 'Reus', 'Salou', 'Cambrils', 'Vila-seca', 'La Canonja', 'Constantí', 'Torredembarra', 'Valls']}
    />
  </main>
  <Footer lang="es" t={flat} />
</BaseLayout>
