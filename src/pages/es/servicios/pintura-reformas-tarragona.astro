---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ServiceLayout from '../../../components/ServiceLayout.astro';
import { flattenI18n } from '../../../utils/i18n';

const rawT = await import('../../../i18n/es.json');
const t = rawT.default;
const flat = flattenI18n(t as unknown as Record<string, unknown>);
---

<BaseLayout
  title="Pintura y reformas en Tarragona | NaturLimp Multiservicios"
  description="Servicios de pintura y reformas para comunidades, viviendas y locales en Tarragona, Reus y Salou. Pintores profesionales y obras de mantenimiento con acabados de primera."
  lang="es"
  canonical="https://naturlimp.com/es/servicios/pintura-reformas-tarragona/"
>
  <Header lang="es" t={flat} />
  <main id="main-content">
    <ServiceLayout
      lang="es"
      t={t}
      heroImage="https://images.unsplash.com/photo-1589939705384-5185137a7f0f?q=80&w=2000&auto=format&fit=crop"
      serviceNum="06"
      serviceTag="Pintura · Reformas · Mantenimiento"
      breadcrumb="Pintura y reformas"
      headline="Pintura y reformas en Tarragona y comarca"
      subheadline="Pintura profesional de escaleras, zaguanes, fachadas y reformas integrales o parciales de mantenimiento para comunidades de propietarios, pisos y comercios."
      stats={[
        { value: '15', label: 'años de experiencia' },
        { value: '300+', label: 'obras y reformas' },
        { value: '30 km', label: 'radio de servicio' },
        { value: 'Garantía', label: 'en todos los trabajos' },
      ]}
      checklist={[
        'Pintura plástica y decorativa de portales, escaleras comunitarias y patios de luces',
        'Reparación de grietas, desconchados, humedades y alisado de paredes con gotelet',
        'Pintura de suelos de garajes con resina epoxi de alta resistencia al tráfico',
        'Rehabilitación y pintura de fachadas exteriores e impermeabilización de terrazas',
        'Pequeñas reformas de albañilería: solados, alicatados y tabiquería de cartón-yeso',
        'Tratamiento y esmaltado de cerrajería, barandillas, verjas y puertas de acceso',
        'Protección exhaustiva de mobiliario, suelos y ascensores durante los trabajos',
        'Limpieza profesional integral tras finalizar la obra para una entrega perfecta',
      ]}
      gallery={[
        { src: 'https://picsum.photos/seed/nl-pint-1/600/820', alt: 'Escalera comunitaria recién pintada en blanco roto', caption: 'Pintura en escalera comunitaria impecable' },
        { src: 'https://picsum.photos/seed/nl-pint-2/500/400', alt: 'Pintor aplicando rodillo en pared lisa', caption: 'Acabados lisos y pintura de calidad' },
        { src: 'https://picsum.photos/seed/nl-pint-3/500/400', alt: 'Suelo de resina epoxi recién pintado en parking', caption: 'Pavimento epoxi para garajes' },
        { src: 'https://picsum.photos/seed/nl-pint-4/900/520', alt: 'Fachada y entrada de comunidad renovada', caption: 'Entrada y zaguán rehabilitado' },
      ]}
      zonesText="Prestamos servicios de pintura y reformas en Tarragona (Part Alta, Serrallo, Eixample, Torreforta, Bonavista), Reus, Salou, Cambrils, Vila-seca, Torredembarra, Altafulla, El Vendrell y toda la Costa Daurada."
      zones={['Tarragona', 'Reus', 'Salou', 'Cambrils', 'Vila-seca', 'Torredembarra', 'Altafulla', 'El Vendrell', 'Valls']}
    />
  </main>
  <Footer lang="es" t={flat} />
</BaseLayout>
