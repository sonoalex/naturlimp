---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LocalSeoLayout from '../../components/LocalSeoLayout.astro';
import { flattenI18n } from '../../utils/i18n';

const rawT = await import('../../i18n/es.json');
const t = rawT.default;
const flat = flattenI18n(t as unknown as Record<string, unknown>);
---

<BaseLayout
  title="Limpieza profesional en Vila-seca | NaturLimp · Tarragona"
  description="Empresa de limpieza en Vila-seca a solo 8 km de Tarragona. Comunidades de vecinos, piscinas comunitarias, final de obra y abrillantado de suelos. Presupuesto en 24 h."
  lang="es"
  canonical="https://naturlimp.com/es/limpieza-profesional-vila-seca"
>
  <Header lang="es" t={flat} />
  <main id="main-content">
    <LocalSeoLayout
      city="Vila-seca"
      citySlug="vila-seca"
      distanceKm={8}
      province="Tarragona"
      t={t}
      lang="es"
    />
  </main>
  <Footer lang="es" t={flat} />
</BaseLayout>
