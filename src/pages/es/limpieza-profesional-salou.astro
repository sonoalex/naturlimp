---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LocalSeoLayout from '../../components/LocalSeoLayout.astro';
import { flattenI18n } from '../../utils/i18n';

const rawT = await import('../../i18n/es.json');
const t = rawT.default;
const flat = flattenI18n(t as unknown as Record<string, unknown>);
---

<BaseLayout
  title="Limpieza profesional en Salou | NaturLimp · Costa Daurada"
  description="Limpieza de comunidades, piscinas comunitarias y final de obra en Salou. Empresa local a 10 km de Tarragona con equipo propio y seguro RC. Presupuesto en 24 h."
  lang="es"
  canonical="https://naturlimp.com/es/limpieza-profesional-salou"
>
  <Header lang="es" t={flat} />
  <main id="main-content">
    <LocalSeoLayout
      city="Salou"
      citySlug="salou"
      distanceKm={10}
      province="Tarragona"
      t={t}
      lang="es"
    />
  </main>
  <Footer lang="es" t={flat} />
</BaseLayout>
