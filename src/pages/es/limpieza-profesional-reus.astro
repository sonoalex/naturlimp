---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LocalSeoLayout from '../../components/LocalSeoLayout.astro';
import { flattenI18n } from '../../utils/i18n';

const rawT = await import('../../i18n/es.json');
const t = rawT.default;
const flat = flattenI18n(t as unknown as Record<string, unknown>);
---

<BaseLayout
  title="Limpieza profesional en Reus | NaturLimp · Empresa local"
  description="Empresa de limpieza en Reus: comunidades de vecinos, piscinas, final de obra, abrillantado de suelos y cristales. Equipo propio a 12 km de Tarragona. Presupuesto gratuito en 24 h."
  lang="es"
  canonical="https://naturlimp.com/es/limpieza-profesional-reus"
>
  <Header lang="es" t={flat} />
  <main id="main-content">
    <LocalSeoLayout
      city="Reus"
      citySlug="reus"
      distanceKm={12}
      province="Tarragona"
      t={t}
      lang="es"
    />
  </main>
  <Footer lang="es" t={flat} />
</BaseLayout>
