---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FAQSection from '../components/FAQSection.astro';
import ServiceAreaMap from '../components/ServiceAreaMap.astro';
import HeroAnimation from '../components/HeroAnimation';
import BeforeAfterSlider from '../components/BeforeAfterSlider';
import ContactForm from '../components/ContactForm';
import TestimonialsScroll from '../components/TestimonialsScroll';
import { getGoogleReviews } from '../data/reviews';
import { flattenI18n } from '../utils/i18n';

const rawT = await import('../i18n/es.json');
const t = rawT.default;
const flat = flattenI18n(t as unknown as Record<string, unknown>);

type ServiceIcon = 'communities' | 'gardening' | 'pools' | 'parking' | 'floors' | 'painting' | 'electricity' | 'construction' | 'offices' | 'tourist-apartments' | 'healthcare' | 'windows';
type ServiceItem = { name: string; desc: string; icon: ServiceIcon; href: string; };

const serviceKeys: { key: string; icon: ServiceIcon; href: string }[] = [
  { key: 'communities',        icon: 'communities',        href: '/es/servicios/limpieza-comunidades-tarragona/' },
  { key: 'gardening',          icon: 'gardening',          href: '/es/servicios/jardineria-tarragona/' },
  { key: 'pools',              icon: 'pools',              href: '/es/servicios/piscinas-comunitarias-tarragona/' },
  { key: 'parking',            icon: 'parking',            href: '/es/servicios/limpieza-parkings-tarragona/' },
  { key: 'floors',             icon: 'floors',             href: '/es/servicios/abrillantado-suelos-tarragona/' },
  { key: 'painting',           icon: 'painting',           href: '/es/servicios/pintura-reformas-tarragona/' },
  { key: 'electricity',        icon: 'electricity',        href: '/es/servicios/electricidad-tarragona/' },
  { key: 'construction',       icon: 'construction',       href: '/es/servicios/limpieza-final-obra-tarragona/' },
  { key: 'offices',            icon: 'offices',            href: '/es/servicios/limpieza-oficinas-tarragona/' },
  { key: 'tourist-apartments', icon: 'tourist-apartments', href: '/es/servicios/apartamentos-turisticos-tarragona/' },
  { key: 'healthcare',         icon: 'healthcare',         href: '/es/servicios/limpieza-centros-salud-colegios-tarragona/' },
];

const serviceIcons: Record<string, string> = {
  communities: `<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>`,
  gardening: `<path d="M12 22v-9"/><path d="M9 13a4.5 4.5 0 0 0 3-4.5 4.5 4.5 0 0 1 6 0 4.5 4.5 0 0 1-6 4.5"/><path d="M15 13a4.5 4.5 0 0 1-3-4.5 4.5 4.5 0 0 0-6 0 4.5 4.5 0 0 0 6 4.5"/>`,
  pools: `<path d="M2 12h4l2-6 4 12 2-8 2 4h6"/><path d="M2 20h20" stroke-width="1.5"/>`,
  parking: `<rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 17V7h4a3 3 0 0 1 0 6H9"/>`,
  floors: `<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>`,
  painting: `<path d="m19 11-8-8-8.6 8.6a2 2 0 0 0 0 2.8l5.2 5.2c.8.8 2 .8 2.8 0L19 11Z"/><path d="m5 2 5 5"/><path d="M2 13h15"/>`,
  electricity: `<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>`,
  construction: `<rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>`,
  offices: `<rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>`,
  'tourist-apartments': `<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/><circle cx="12" cy="7" r="1"/>`,
  healthcare: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><line x1="12" y1="8" x2="12" y2="14"/><line x1="9" y1="11" x2="15" y2="11"/>`,
  windows: `<rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/><line x1="2" y1="10" x2="22" y2="10"/><line x1="12" y1="3" x2="12" y2="17"/>`,
};

const items = t.services.items as unknown as Record<string, { name: string; desc: string }>;
const services: ServiceItem[] = serviceKeys.map(({ key, icon, href }) => ({
  name: items[key].name,
  desc: items[key].desc,
  icon,
  href,
}));

const beforeAfterItems = [
  {
    before: '/images/before-after/before-1.jpeg',
    after:  '/images/before-after/after-1.jpeg',
    label:  'Local comercial',
    description: 'Local limpieza aguas residuales y trabajo de arreglo de techo y cambio de codos de desagüe',
    beforeAlt: 'Local inundado de aguas residuales antes de la intervención de limpieza',
    afterAlt:  'Local impecable y desinfectado tras la limpieza y reparación de codos de desagüe',
  },
  {
    before: '/images/before-after/before-suelo.webp',
    after:  '/images/before-after/after-suelo.webp',
    label:  'Abrillantado de suelos',
    description: 'Cristalizado y pulido de mármol y terrazo para recuperar su brillo de espejo original',
    beforeAlt: 'Suelo de terrazo opaco antes del abrillantado',
    afterAlt:  'Suelo de mármol pulido y abrillantado efecto espejo',
  },
  {
    before: '/images/before-after/before-pool.webp',
    after:  '/images/before-after/after-pool.webp',
    label:  'Limpieza piscinas',
    description: 'Puesta a punto y desinfección integral con tratamiento de choque para aguas cristalinas',
    beforeAlt: 'Piscina comunitaria antes de la limpieza',
    afterAlt:  'Piscina comunitaria limpia y con agua cristalina',
  },
  {
    before: '/images/before-after/before-obra.webp',
    after:  '/images/before-after/after-obra.webp',
    label:  'Final de obra',
    description: 'Limpieza exhaustiva tras obra: eliminación de restos de yeso, manchas de pintura y polvo fino',
    beforeAlt: 'Suelo de obra antes de la limpieza con polvo y residuos',
    afterAlt:  'Suelo de obra después de la limpieza impecable y listo para entrega',
  },
];

const testimonials = getGoogleReviews('es');

const stats = [
  { value: '200+', label: t.stats.clients },
  { value: '17',   label: t.stats.years },
  { value: '13',   label: t.stats.zones },
  { value: '4.9★', label: t.stats.rating },
];

const trustStats = [
  { value: '17',    label: t.trust.years },
  { value: 'RC',    label: t.trust.insured },
  { value: '100%',  label: t.trust.team },
  { value: '30 km', label: t.trust.local },
];
---

<BaseLayout
  title="Limpieza profesional en Tarragona y comarca | NaturLimp"
  description="Empresa de limpieza en Tarragona especializada en comunidades de vecinos, piscinas, final de obra y abrillantado de suelos. Servicio en Reus, Salou, Cambrils y 30km. Presupuesto sin compromiso."
  lang="es"
>
  <Header lang="es" t={flat} />

  <main id="main-content">

    <HeroAnimation
      client:load
      subheadline={t.hero.subheadline}
      ctaPrimary={t.hero.cta_primary}
      ctaSecondary={t.hero.cta_secondary}
      badge={t.hero.badge}
      lang="es"
    />

    <!-- ── Trust bar ──────────────────────────────────────────────────────────── -->
    <section class="border-b border-[var(--color-primary-dark)]/30 bg-[var(--color-primary)]" aria-label="Credenciales">
      <div class="mx-auto max-w-7xl">
        <ul class="grid grid-cols-2 divide-x divide-y divide-[var(--color-foreground)]/15 sm:grid-cols-4 sm:divide-y-0" role="list">
          {trustStats.map(({ value, label }) => (
            <li class="px-6 py-5 text-center sm:px-8">
              <span class="block font-display text-2xl font-bold text-[var(--color-foreground)] tabular-nums">{value}</span>
              <span class="mt-0.5 block text-xs text-[var(--color-foreground)]/70">{label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ── Services ───────────────────────────────────────────────────────────── -->
    <section id="servicios" class="bg-[var(--color-background)]" aria-labelledby="services-heading">

      <div class="mx-auto max-w-7xl px-6 pt-20 pb-0 sm:px-8 lg:px-12">
        <div class="flex flex-col gap-2 border-b border-[var(--color-border)] pb-10 sm:flex-row sm:items-end sm:justify-between">
          <h2 id="services-heading" class="font-display text-4xl font-bold text-[var(--color-foreground)] sm:text-5xl">
            {t.services.title}
          </h2>
          <p class="max-w-xs text-sm text-[var(--color-muted-fg)] sm:text-right">{t.services.subtitle}</p>
        </div>
      </div>

      <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-12">
        {services.map((svc, index) => (
          <a
            href={svc.href}
            class="group flex items-center gap-5 border-b border-[var(--color-border)] py-7 transition-colors duration-200 hover:bg-[var(--color-primary)]/[0.025] active:bg-[var(--color-primary)]/[0.05] sm:gap-8 sm:py-8 -mx-6 px-6 sm:-mx-8 sm:px-8 lg:-mx-12 lg:px-12"
          >
            <span class="w-10 flex-shrink-0 font-display text-2xl font-bold tabular-nums text-[var(--color-primary)]/25 sm:w-14 sm:text-3xl">
              {String(index + 1).padStart(2, '0')}
            </span>

            <div class="hidden h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-[var(--color-primary-light)] sm:flex">
              <svg
                width="20" height="20" viewBox="0 0 24 24"
                fill="none" stroke="var(--color-primary-dark)" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"
                aria-hidden="true" set:html={serviceIcons[svc.icon]}
              />
            </div>

            <div class="flex flex-1 flex-col gap-1 sm:flex-row sm:items-center sm:gap-10">
              <h3 class="font-heading text-lg font-semibold text-[var(--color-foreground)] sm:w-64 sm:flex-shrink-0">
                {svc.name}
              </h3>
              <p class="text-sm text-[var(--color-muted-fg)] sm:flex-1">{svc.desc}</p>
            </div>

            <svg
              class="ml-2 h-5 w-5 flex-shrink-0 text-[var(--color-primary)] opacity-40 md:opacity-0 transition-[transform,opacity] duration-200 group-hover:translate-x-1 group-hover:opacity-100 group-focus-visible:translate-x-1 group-focus-visible:opacity-100 group-active:translate-x-1 group-active:opacity-100"
              viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        ))}
      </div>

      <div class="pb-20" />
    </section>

    <!-- ── Before / After ─────────────────────────────────────────────────────── -->
    <section id="antes-despues" class="py-20 bg-[var(--color-foreground)]" aria-labelledby="ba-heading">
      <div class="mx-auto max-w-7xl px-6 sm:px-10 lg:px-14">
        <div class="flex flex-col gap-2 border-b border-white/10 pb-10 mb-10 sm:flex-row sm:items-end sm:justify-between">
          <h2 id="ba-heading" class="font-display text-4xl font-bold text-white sm:text-5xl">
            {t.before_after.title}
          </h2>
          <p class="max-w-xs text-sm text-white/50 sm:text-right">{t.before_after.subtitle}</p>
        </div>
        <BeforeAfterSlider client:load items={beforeAfterItems} dragHint={t.before_after.drag_hint} lang="es" dark />
      </div>
    </section>

    <!-- ── Map ────────────────────────────────────────────────────────────────── -->
    <ServiceAreaMap title={t.map.title} subtitle={t.map.subtitle} lang="es" />

    <!-- ── Testimonials ───────────────────────────────────────────────────────── -->
    <section id="testimonios" class="py-20 bg-[var(--color-surface)]" aria-labelledby="testimonials-heading">
      <div class="mx-auto max-w-7xl px-6 sm:px-10 lg:px-14">
        <div class="flex flex-col gap-4 border-b border-[var(--color-border)] pb-10 mb-10 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white border border-[var(--color-border)] shadow-sm mb-3">
              <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
              </svg>
              <div class="flex gap-0.5 text-amber-500" aria-hidden="true">
                {[1, 2, 3, 4, 5].map(() => (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="#f59e0b">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                  </svg>
                ))}
              </div>
              <span class="text-xs font-bold text-[var(--color-foreground)]">4.9 / 5</span>
              <span class="text-xs text-[var(--color-muted-fg)]">· 53 reseñas en Google</span>
            </div>
            <h2 id="testimonials-heading" class="font-display text-4xl font-bold text-[var(--color-foreground)] sm:text-5xl">
              {t.testimonials.title}
            </h2>
          </div>
          <p class="max-w-xs text-sm text-[var(--color-muted-fg)] sm:text-right">{t.testimonials.subtitle}</p>
        </div>
        <TestimonialsScroll client:visible testimonials={testimonials} />
      </div>
    </section>

    <!-- ── Stats ──────────────────────────────────────────────────────────────── -->
    <section class="bg-[var(--color-foreground)]" aria-label="Estadísticas">
      <div class="mx-auto max-w-7xl">
        <ul class="grid grid-cols-2 gap-px bg-white/5 sm:grid-cols-4" role="list">
          {stats.map(({ value, label }) => (
            <li class="bg-[var(--color-foreground)] px-6 py-14 text-center">
              <span class="block font-display text-5xl font-bold text-[var(--color-primary-light)] sm:text-6xl tabular-nums">{value}</span>
              <span class="mt-2 block text-xs uppercase tracking-widest text-white/35">{label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ── FAQ ────────────────────────────────────────────────────────────────── -->
    <FAQSection title={t.faq.title} subtitle={t.faq.subtitle} items={t.faq.items} lang="es" />

    <!-- ── Contact ────────────────────────────────────────────────────────────── -->
    <section id="contacto" class="relative py-24 bg-[var(--color-foreground)] overflow-hidden" aria-labelledby="contact-heading">

      <!-- Green glow behind left column -->
      <div class="pointer-events-none absolute inset-0" aria-hidden="true" style="background: radial-gradient(ellipse 55% 70% at 10% 60%, rgba(162,217,97,0.18) 0%, transparent 65%);" />

      <div class="relative mx-auto max-w-7xl px-6 sm:px-10 lg:px-14">
        <div class="grid grid-cols-1 gap-16 lg:grid-cols-2 lg:gap-20 xl:gap-28">

          <!-- Left: info + contact methods -->
          <div class="flex flex-col justify-center">

            <div class="mb-8 inline-flex w-fit items-center gap-2 rounded-sm border border-[var(--color-primary)]/40 bg-[var(--color-primary)]/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--color-primary-light)]">
              <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-primary)]" aria-hidden="true"></span>
              Presupuesto gratuito
            </div>

            <h2 id="contact-heading" class="font-display text-4xl font-bold text-white sm:text-5xl lg:text-6xl" style="line-height:1.05">
              {t.contact.title}
            </h2>
            <p class="mt-5 max-w-sm text-lg leading-relaxed text-white/45">
              {t.contact.subtitle}
            </p>

            <!-- Direct contact methods -->
            <div class="mt-10 space-y-3">
              <a
                href="tel:+34603765253"
                class="group flex items-center gap-4 rounded-xl border border-white/8 px-4 py-3.5 transition-colors duration-200 hover:border-[var(--color-primary)]/40 hover:bg-white/4"
              >
                <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-[var(--color-primary)]/20 text-[var(--color-primary-light)] transition-colors group-hover:bg-[var(--color-primary)]/30">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.99 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.9 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
                  </svg>
                </span>
                <div>
                  <span class="block text-[11px] uppercase tracking-widest text-white/35">Teléfono</span>
                  <span class="block text-sm font-semibold text-white">603 765 253</span>
                </div>
              </a>

              <a
                href="https://wa.me/34603765253?text=Hola%2C%20me%20gustar%C3%ADa%20pedir%20un%20presupuesto"
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-4 rounded-xl border border-white/8 px-4 py-3.5 transition-colors duration-200 hover:border-[var(--color-primary)]/40 hover:bg-white/4"
              >
                <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-[var(--color-primary)]/20 text-[var(--color-primary-light)] transition-colors group-hover:bg-[var(--color-primary)]/30">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
                  </svg>
                </span>
                <div>
                  <span class="block text-[11px] uppercase tracking-widest text-white/35">WhatsApp</span>
                  <span class="block text-sm font-semibold text-white">Escríbenos directamente</span>
                </div>
              </a>

              <a
                href="mailto:contacto@naturlimp.com"
                class="group flex items-center gap-4 rounded-xl border border-white/8 px-4 py-3.5 transition-colors duration-200 hover:border-[var(--color-primary)]/40 hover:bg-white/4"
              >
                <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-[var(--color-primary)]/20 text-[var(--color-primary-light)] transition-colors group-hover:bg-[var(--color-primary)]/30">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                  </svg>
                </span>
                <div>
                  <span class="block text-[11px] uppercase tracking-widest text-white/35">Email</span>
                  <span class="block text-sm font-semibold text-white">contacto@naturlimp.com</span>
                </div>
              </a>
            </div>

            <!-- Trust signals -->
            <div class="mt-10 border-t border-white/8 pt-8 flex flex-col gap-2.5">
              {['Respuesta en menos de 24 horas', 'Presupuesto sin compromiso', 'Servicio en toda la provincia de Tarragona'].map(s => (
                <span class="flex items-center gap-2.5 text-sm text-white/30">
                  <span class="h-px w-4 flex-shrink-0 bg-[var(--color-primary)]" aria-hidden="true"></span>
                  {s}
                </span>
              ))}
            </div>
          </div>

          <!-- Right: form card -->
          <div class="rounded-2xl bg-white p-8 shadow-2xl lg:p-10">
            <ContactForm client:visible t={t.contact} lang="es" />
          </div>

        </div>
      </div>
    </section>

  </main>

  <Footer lang="es" t={flat} />
</BaseLayout>
