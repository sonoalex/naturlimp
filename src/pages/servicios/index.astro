---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import BeforeAfterSlider from '../../components/BeforeAfterSlider';
import ContactForm from '../../components/ContactForm';
import FAQSection from '../../components/FAQSection.astro';
import { flattenI18n } from '../../utils/i18n';

const rawT = await import('../../i18n/es.json');
const t = rawT.default;
const flat = flattenI18n(t as unknown as Record<string, unknown>);

const servicesList = [
  {
    name: 'Comunidades de vecinos',
    desc: 'Limpieza integral y periódica de portales, escaleras, garajes, ascensores y rellanos. Planes adaptados a comunidades grandes y pequeñas.',
    icon: 'communities' as const,
    href: '/es/servicios/limpieza-comunidades-tarragona',
    ctaLabel: 'Ver servicio de comunidades',
    featured: true,
  },
  {
    name: 'Piscinas comunitarias',
    desc: 'Mantenimiento, limpieza profunda y desinfección homologada de piscinas para comunidades en Tarragona, Salou y Cambrils.',
    icon: 'pools' as const,
    href: '/es/servicios/piscinas-comunitarias-tarragona',
    ctaLabel: 'Ver mantenimiento de piscinas',
  },
  {
    name: 'Limpieza final de obra',
    desc: 'Eliminación exhaustiva de restos de pintura, cemento, polvo de yeso y residuos tras reformas o construcción nueva.',
    icon: 'construction' as const,
    href: '/es/servicios/limpieza-final-obra-tarragona',
    ctaLabel: 'Ver limpieza fin de obra',
  },
  {
    name: 'Abrillantado de suelos',
    desc: 'Cristalizado, pulido y abrillantado profesional de mármol, terrazo y pavimentos duros. Recupera el brillo natural.',
    icon: 'floors' as const,
    href: '/es/servicios/abrillantado-suelos-tarragona',
    ctaLabel: 'Ver abrillantado de suelos',
  },
  {
    name: 'Limpieza de cristales',
    desc: 'Cristales, ventanales, escaparates y fachadas acristaladas con técnicas en altura y productos repelentes de agua y polvo.',
    icon: 'windows' as const,
    href: '/es/servicios/limpieza-cristales-tarragona',
    ctaLabel: 'Ver limpieza de cristales',
  },
  {
    name: 'Oficinas y locales',
    desc: 'Mantenimiento diario, semanal o mensual de oficinas, despachos, naves y comercios. Flexibilidad horaria sin interrumpir tu actividad.',
    icon: 'offices' as const,
    href: '/es/servicios/limpieza-oficinas-tarragona',
    ctaLabel: 'Ver limpieza de oficinas',
  },
];

const beforeAfterItems = [
  {
    before: 'https://picsum.photos/seed/nl-obra-b/700/340',
    after:  'https://picsum.photos/seed/nl-obra-a/700/340',
    label:  'Final de obra',
    beforeAlt: 'Suelo de obra antes de la limpieza — polvo y residuos',
    afterAlt:  'Suelo de obra después de la limpieza — impecable',
  },
  {
    before: 'https://picsum.photos/seed/nl-suelo-b/700/340',
    after:  'https://picsum.photos/seed/nl-suelo-a/700/340',
    label:  'Abrillantado de suelos',
    beforeAlt: 'Suelo de terrazo opaco antes del abrillantado',
    afterAlt:  'Suelo de terrazo brillante después del abrillantado',
  },
  {
    before: 'https://picsum.photos/seed/nl-pool-b/700/340',
    after:  'https://picsum.photos/seed/nl-pool-a/700/340',
    label:  'Limpieza piscinas',
    beforeAlt: 'Piscina comunitaria con algas antes de la limpieza',
    afterAlt:  'Piscina comunitaria limpia y transparente',
  },
];
---

<BaseLayout
  title="Servicios de Limpieza en Tarragona — NaturLimp"
  description="Empresa de limpieza y multiservicios en Tarragona. Servicios profesionales para comunidades de vecinos, oficinas, final de obra, abrillantado, cristales y piscinas."
  lang="es"
  canonical="https://naturlimp.com/servicios/"
>
  <Header lang="es" t={flat} />

  <main id="main-content">

    <!-- ── Hero Section ───────────────────────────────────────────────────────── -->
    <section class="relative bg-[var(--color-foreground)] text-white pt-32 pb-20 overflow-hidden">
      <!-- Background glow -->
      <div
        class="pointer-events-none absolute inset-0"
        style="background: radial-gradient(ellipse 65% 60% at 50% 20%, rgba(162,217,97,0.18) 0%, transparent 70%);"
        aria-hidden="true"
      />

      <div class="relative mx-auto max-w-7xl px-6 sm:px-10 lg:px-14">
        <!-- Breadcrumb -->
        <nav class="mb-6 flex items-center gap-2 text-xs text-white/50" aria-label="Miga de pan">
          <a href="/" class="hover:text-white transition-colors">Inicio</a>
          <span>/</span>
          <span class="text-[var(--color-primary)] font-medium">Servicios</span>
        </nav>

        <div class="max-w-3xl">
          <div class="mb-5 inline-flex items-center gap-2 rounded-sm border border-[var(--color-primary)]/40 bg-[var(--color-primary)]/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--color-primary-light)]">
            <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-primary)]" aria-hidden="true"></span>
            Multiservicios Profesionales
          </div>
          <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-tight">
            Servicios de Limpieza y Multiservicios en Tarragona
          </h1>
          <p class="mt-6 text-lg text-white/60 leading-relaxed">
            Más de 15 años de experiencia ofreciendo máxima calidad, sostenibilidad y atención personalizada para comunidades, empresas y particulares en Tarragona y comarca.
          </p>

          <!-- Badges bar -->
          <div class="mt-8 flex flex-wrap gap-4 text-xs font-semibold text-white/80">
            <span class="inline-flex items-center gap-2 rounded-lg bg-white/5 border border-white/10 px-3 py-1.5">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-[var(--color-primary)]"><path d="M20 6L9 17l-5-5"/></svg>
              Seguro RC Incluido
            </span>
            <span class="inline-flex items-center gap-2 rounded-lg bg-white/5 border border-white/10 px-3 py-1.5">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-[var(--color-primary)]"><path d="M20 6L9 17l-5-5"/></svg>
              Equipo Propio Cualificado
            </span>
            <span class="inline-flex items-center gap-2 rounded-lg bg-white/5 border border-white/10 px-3 py-1.5">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-[var(--color-primary)]"><path d="M20 6L9 17l-5-5"/></svg>
              Productos Ecológicos Certificados
            </span>
            <span class="inline-flex items-center gap-2 rounded-lg bg-white/5 border border-white/10 px-3 py-1.5">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-[var(--color-primary)]"><path d="M20 6L9 17l-5-5"/></svg>
              Presupuesto en 24h Sin Compromiso
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Main Services Grid ─────────────────────────────────────────────────── -->
    <section class="py-20 bg-[var(--color-background)]" aria-labelledby="catalog-heading">
      <div class="mx-auto max-w-7xl px-6 sm:px-10 lg:px-14">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <h2 id="catalog-heading" class="font-display text-3xl sm:text-4xl font-bold text-[var(--color-foreground)]">
            Catálogo de Servicios de Limpieza
          </h2>
          <p class="mt-3 text-sm text-[var(--color-muted-fg)]">
            Selecciona el servicio que necesitas para consultar los detalles específicos y solicitar presupuesto.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {servicesList.map(svc => (
            <div class="h-full">
              <ServiceCard
                name={svc.name}
                desc={svc.desc}
                icon={svc.icon}
                href={svc.href}
                ctaLabel={svc.ctaLabel}
                featured={svc.featured}
              />
            </div>
          ))}
        </div>

        <!-- Additional Multiservices Banner -->
        <div class="mt-14 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-8 sm:p-10 shadow-sm">
          <div class="flex flex-col lg:flex-row items-center justify-between gap-6">
            <div class="space-y-2 text-center lg:text-left">
              <span class="inline-block text-xs font-bold uppercase tracking-wider text-[var(--color-primary-dark)]">
                Multiservicios Integrales
              </span>
              <h3 class="font-display text-2xl font-bold text-[var(--color-foreground)]">
                ¿Necesitas trabajos especiales de reformas, pintura o jardinería?
              </h3>
              <p class="text-sm text-[var(--color-muted-fg)] max-w-2xl leading-relaxed">
                En NaturLimp también ofrecemos pulidos y diamantados de suelos, mantenimiento de jardines comunitarios, pintura de parkings y pequeñas reformas integrales para comunidades y negocios.
              </p>
            </div>
            <a
              href="/contacto"
              class="inline-flex items-center justify-center font-display font-bold px-6 py-3 rounded-full bg-[var(--color-primary)] text-[var(--color-foreground)] hover:bg-[var(--color-accent)] transition-colors shrink-0 text-sm shadow-sm"
            >
              Consultar otros multiservicios
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Before / After Interactive ─────────────────────────────────────────── -->
    <section class="py-20 bg-[var(--color-muted)]" aria-labelledby="before-after-heading">
      <div class="mx-auto max-w-7xl px-6 sm:px-10 lg:px-14">
        <div class="text-center max-w-xl mx-auto mb-12">
          <span class="inline-block text-xs font-bold uppercase tracking-widest text-[var(--color-primary-dark)] mb-2">
            Resultados comprobados
          </span>
          <h2 id="before-after-heading" class="font-display text-3xl sm:text-4xl font-bold text-[var(--color-foreground)]">
            Antes y Después de Nuestros Trabajos
          </h2>
          <p class="mt-3 text-sm text-[var(--color-muted-fg)]">
            Arrastra el selector para comprobar la eficacia de nuestros equipos y tratamientos.
          </p>
        </div>

        <div class="mx-auto max-w-4xl">
          <BeforeAfterSlider client:visible items={beforeAfterItems} />
        </div>
      </div>
    </section>

    <!-- ── FAQ Section ────────────────────────────────────────────────────────── -->
    <FAQSection
      title={t.faq.title}
      subtitle={t.faq.subtitle}
      items={t.faq.items}
      lang="es"
    />

    <!-- ── Contact / CTA Section ──────────────────────────────────────────────── -->
    <section id="contacto" class="relative py-24 bg-[var(--color-foreground)] overflow-hidden" aria-labelledby="contact-heading">
      <div
        class="pointer-events-none absolute inset-0"
        aria-hidden="true"
        style="background: radial-gradient(ellipse 55% 70% at 10% 60%, rgba(162,217,97,0.18) 0%, transparent 65%);"
      />

      <div class="relative mx-auto max-w-7xl px-6 sm:px-10 lg:px-14">
        <div class="grid grid-cols-1 gap-16 lg:grid-cols-2 lg:gap-20 xl:gap-28">

          <!-- Left Info -->
          <div class="flex flex-col justify-center">
            <div class="mb-8 inline-flex w-fit items-center gap-2 rounded-sm border border-[var(--color-primary)]/40 bg-[var(--color-primary)]/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--color-primary-light)]">
              <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-primary)]" aria-hidden="true"></span>
              {t.contact.title}
            </div>

            <h2 id="contact-heading" class="font-display text-4xl font-bold text-white sm:text-5xl lg:text-6xl" style="line-height:1.05">
              Pide tu presupuesto a medida
            </h2>
            <p class="mt-5 max-w-sm text-lg leading-relaxed text-white/45">
              Sin compromiso ni permanencia. Te visitamos o enviamos propuesta detallada en menos de 24 horas.
            </p>

            <!-- Direct contacts -->
            <div class="mt-10 space-y-3">
              <a
                href="tel:+34603765253"
                class="group flex items-center gap-4 rounded-xl border border-white/8 px-4 py-3.5 transition-colors duration-200 hover:border-[var(--color-primary)]/40 hover:bg-white/4"
              >
                <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-[var(--color-primary)]/20 text-[var(--color-primary-light)] transition-colors group-hover:bg-[var(--color-primary)]/30">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.99 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.9 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
                  </svg>
                </span>
                <div>
                  <span class="block text-[11px] uppercase tracking-widest text-white/35">Teléfono directo</span>
                  <span class="block text-sm font-semibold text-white">603 765 253</span>
                </div>
              </a>

              <a
                href="https://wa.me/34603765253?text=Hola%2C%20me%20gustar%C3%ADa%20pedir%20un%20presupuesto"
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-4 rounded-xl border border-white/8 px-4 py-3.5 transition-colors duration-200 hover:border-[var(--color-primary)]/40 hover:bg-white/4"
              >
                <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-[var(--color-primary)]/20 text-[var(--color-primary-light)] transition-colors group-hover:bg-[var(--color-primary)]/30">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
                  </svg>
                </span>
                <div>
                  <span class="block text-[11px] uppercase tracking-widest text-white/35">WhatsApp</span>
                  <span class="block text-sm font-semibold text-white">Escríbenos directamente</span>
                </div>
              </a>

              <a
                href="mailto:contacto@naturlimp.com"
                class="group flex items-center gap-4 rounded-xl border border-white/8 px-4 py-3.5 transition-colors duration-200 hover:border-[var(--color-primary)]/40 hover:bg-white/4"
              >
                <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-[var(--color-primary)]/20 text-[var(--color-primary-light)] transition-colors group-hover:bg-[var(--color-primary)]/30">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                  </svg>
                </span>
                <div>
                  <span class="block text-[11px] uppercase tracking-widest text-white/35">Email</span>
                  <span class="block text-sm font-semibold text-white">contacto@naturlimp.com</span>
                </div>
              </a>
            </div>
          </div>

          <!-- Right: Interactive Form -->
          <div class="flex items-center">
            <div class="w-full rounded-2xl border border-white/10 bg-white/[0.03] p-8 backdrop-blur-sm sm:p-10 shadow-2xl">
              <ContactForm client:visible t={t.contact} />
            </div>
          </div>

        </div>
      </div>
    </section>

  </main>

  <Footer lang="es" t={flat} />
</BaseLayout>
