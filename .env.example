# URL del CSV de Google Sheets para testimonios/reseñas
PUBLIC_CSV_URL="https://docs.google.com/spreadsheets/d/e/.../pub?gid=0&single=true&output=csv"

# Control de indexación en buscadores:
# Por seguridad, el sitio por defecto NO indexa (<meta name="robots" content="noindex, nofollow" />)
# Solo indexará en producción si se especifica:
PUBLIC_INDEX_SITE="true"

# O alternativamente definiendo el entorno como 'production':
ENVIRONMENT="production"
